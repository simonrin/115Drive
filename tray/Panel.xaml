<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="115Drive 同步进度" Width="376" SizeToContent="Height" MaxHeight="646"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        ResizeMode="NoResize" Topmost="True" FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Foreground" Value="{StaticResource ThemeAccent}"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderBrush" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="10,7"/>
   <Setter Property="HorizontalContentAlignment" Value="Center"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Grid>
       <Border Background="{TemplateBinding Background}" CornerRadius="7" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}"/>
       <Border x:Name="Hover" Background="{TemplateBinding Foreground}" CornerRadius="7" Opacity="0"/>
       <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
      </Grid>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value=".08"/></Trigger>
       <Trigger Property="IsPressed" Value="True"><Setter TargetName="Hover" Property="Opacity" Value=".16"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Foreground" Value="#ECF4FF"/><Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="0"/>
  </Style>
  <Style TargetType="ToolTip"><Setter Property="FontFamily" Value="{StaticResource UiFont}"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#1C334B"/><Setter Property="BorderBrush" Value="#CFDCE6"/></Style>
  <ControlTemplate x:Key="ScrollPage" TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
  <Style x:Key="VerticalScroll" TargetType="ScrollBar">
   <Style.Triggers>
    <Trigger Property="Orientation" Value="Vertical">
     <Setter Property="Width" Value="12"/>
     <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
      <Border Background="Transparent" Padding="3,0">
       <Track x:Name="PART_Track" IsDirectionReversed="True">
        <Track.DecreaseRepeatButton><RepeatButton Template="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand" Focusable="False"/></Track.DecreaseRepeatButton>
        <Track.Thumb><Thumb MinHeight="24"><Thumb.Template><ControlTemplate TargetType="Thumb">
         <Border x:Name="Grip" Background="#B6C6D3" CornerRadius="3"/>
         <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="#7892A6"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
        <Track.IncreaseRepeatButton><RepeatButton Template="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand" Focusable="False"/></Track.IncreaseRepeatButton>
       </Track>
      </Border>
     </ControlTemplate></Setter.Value></Setter>
    </Trigger>
   </Style.Triggers>
  </Style>
  <Style TargetType="ScrollBar" BasedOn="{StaticResource VerticalScroll}"/>
  <Style x:Key="ActionIcon" TargetType="Path">
   <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
   <Setter Property="StrokeThickness" Value="1.65"/>
   <Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/><Setter Property="StrokeLineJoin" Value="Round"/>
   <Setter Property="Width" Value="22"/><Setter Property="Height" Value="22"/><Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="FooterLabel" TargetType="TextBlock">
   <Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="5,0,0,0"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <!-- All four stroke-only symbols share a 24 × 24 canvas and a 19-unit circle. -->
  <EllipseGeometry x:Key="StatusRing" Center="12,12" RadiusX="9.5" RadiusY="9.5"/>
  <PathGeometry x:Key="Glyph-sync" Figures="M 2.5,12 A 9.5,9.5 0 0 1 20.6,8 L 20.4,3.8 M 20.6,8 L 16.4,7.8 M 21.5,12 A 9.5,9.5 0 0 1 3.4,16 L 3.6,20.2 M 3.4,16 L 7.6,16.2"/>
  <GeometryGroup x:Key="Glyph-idle">
   <GeometryCollection><StaticResource ResourceKey="StatusRing"/><PathGeometry Figures="M 7.5,12.2 L 10.6,15.3 L 16.8,8.9"/></GeometryCollection>
  </GeometryGroup>
  <GeometryGroup x:Key="Glyph-error">
   <GeometryCollection><StaticResource ResourceKey="StatusRing"/><PathGeometry Figures="M 12,7 L 12,12.6 M 12,16 L 12,16.25"/></GeometryCollection>
  </GeometryGroup>
  <GeometryGroup x:Key="Glyph-paused">
   <GeometryCollection><StaticResource ResourceKey="StatusRing"/><PathGeometry Figures="M 9.5,8 L 9.5,16 M 14.5,8 L 14.5,16"/></GeometryCollection>
  </GeometryGroup>
 </Window.Resources>
 <Border Margin="12" Background="White" BorderBrush="#CCD9E4" BorderThickness="1" CornerRadius="13">
  <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity=".16"/></Border.Effect>
  <Grid>
   <Grid.RowDefinitions>
    <RowDefinition Height="74"/><RowDefinition Height="*"/>
    <RowDefinition Height="18"/><RowDefinition Height="18"/><RowDefinition Height="55"/>
   </Grid.RowDefinitions>
   <Border CornerRadius="12,12,0,0" Background="{StaticResource ThemeAccent}">
    <Grid>
     <Canvas IsHitTestVisible="False" ClipToBounds="True" Margin="0,1">
      <Path Data="M 180,82 L 252,-8 M 199,82 L 271,-8 M 218,82 L 290,-8 M 187,61 L 290,61 L 241,-2" Stroke="#18BDDEF2" StrokeThickness="1"/>
     </Canvas>
     <Grid Margin="15,0,12,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition/><ColumnDefinition Width="34"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
      <Border Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="9" Background="#F6FAFF">
       <Image x:Name="BrandIcon" Width="33" Height="33" RenderOptions.BitmapScalingMode="HighQuality"/>
      </Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
       <TextBlock x:Name="BrandTitle" Text="115Drive" FontFamily="{StaticResource BrandFont}" FontWeight="SemiBold" FontSize="23" Foreground="#FFFFFF"/>
       <TextBlock Text="115 网盘 · 双向同步" FontSize="12" Foreground="#E7EFF6" Margin="1,1,0,0"/>
      </StackPanel>
      <Button x:Name="SettingsButton" Grid.Column="2" Style="{StaticResource HeaderButton}" ToolTip="连接与设置" AutomationProperties.Name="连接与设置">
       <Path Style="{StaticResource ActionIcon}" Data="M 9 2 L 13 2 L 13.7 4.5 L 15.3 5.4 L 17.8 4.8 L 19.8 8.2 L 18 10 L 18 12 L 19.8 13.8 L 17.8 17.2 L 15.3 16.6 L 13.7 17.5 L 13 20 L 9 20 L 8.3 17.5 L 6.7 16.6 L 4.2 17.2 L 2.2 13.8 L 4 12 L 4 10 L 2.2 8.2 L 4.2 4.8 L 6.7 5.4 L 8.3 4.5 Z M 14 11 A 3 3 0 1 1 8 11 A 3 3 0 1 1 14 11"/>
      </Button>
      <Button x:Name="CloseButton" Grid.Column="3" Style="{StaticResource HeaderButton}" ToolTip="收起" AutomationProperties.Name="收起">
       <Path Style="{StaticResource ActionIcon}" Data="M 5 5 L 17 17 M 17 5 L 5 17"/>
      </Button>
     </Grid>
    </Grid>
   </Border>
   <Grid Grid.Row="1" Margin="0,13,0,4">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Margin="16,0,16,5">
     <TextBlock Text="最近活动" FontSize="16" Foreground="{StaticResource ThemeAccent}"/>
     <TextBlock x:Name="LastSyncLabel" FontSize="12" Foreground="#546A7C" VerticalAlignment="Center" HorizontalAlignment="Right"/>
    </Grid>
    <ScrollViewer x:Name="ActivityScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel x:Name="ActivityList" Margin="7,0"/>
    </ScrollViewer>
   </Grid>
   <Border Grid.Row="3" Grid.RowSpan="2" Background="#F4F7FA" CornerRadius="0,0,12,12" BorderBrush="#D5E0EA" BorderThickness="0,1,0,0">
    <UniformGrid Columns="3" Margin="7,23,7,9">
     <Button x:Name="FolderButton" Padding="4" AutomationProperties.Name="打开文件夹">
      <StackPanel Orientation="Horizontal"><Path Style="{StaticResource ActionIcon}" Data="M 2 18 L 2 5 Q 2 3 4 3 L 8 3 L 10 6 L 18 6 Q 20 6 20 8 L 20 10 M 2 18 L 5 10 L 21 10 L 18 18 Z"/><TextBlock Text="打开文件夹" Style="{StaticResource FooterLabel}"/></StackPanel>
     </Button>
     <Button x:Name="SyncButton" Padding="4" Margin="3,0" Background="{StaticResource ThemeAccent}" Foreground="White" AutomationProperties.Name="立即同步">
      <StackPanel Orientation="Horizontal"><Path Style="{StaticResource ActionIcon}" Data="M 18 7 A 7.5 7.5 0 0 0 4 8 M 18 2 L 18 7 L 13 7 M 4 15 A 7.5 7.5 0 0 0 18 14 M 4 20 L 4 15 L 9 15"/><TextBlock Text="立即同步" Style="{StaticResource FooterLabel}"/></StackPanel>
     </Button>
     <Button x:Name="PauseButton" Padding="4">
      <StackPanel Orientation="Horizontal"><Path x:Name="PauseGlyph" Style="{StaticResource ActionIcon}" StrokeThickness="2.1" Data="M 7 4 L 7 18 M 15 4 L 15 18"/><TextBlock x:Name="PauseLabel" Text="暂停同步" Style="{StaticResource FooterLabel}"/></StackPanel>
     </Button>
    </UniformGrid>
   </Border>
   <Button x:Name="StatusCard" Grid.Row="2" Grid.RowSpan="2" Panel.ZIndex="1" Width="36" Height="36"
           HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0" IsEnabled="False"
           ToolTipService.ShowOnDisabled="True" ToolTipService.InitialShowDelay="300" ToolTipService.ShowDuration="2147483647">
    <Button.Template>
     <ControlTemplate TargetType="Button">
      <Grid>
       <Border x:Name="Disc" CornerRadius="18" Background="White" BorderBrush="#C8D8E5" BorderThickness="1">
        <Border.Effect><DropShadowEffect Color="#264861" BlurRadius="7" ShadowDepth="2" Opacity=".18"/></Border.Effect>
       </Border>
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>
      <ControlTemplate.Triggers>
       <Trigger Property="IsEnabled" Value="False"><Setter Property="Cursor" Value="Arrow"/></Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Disc" Property="BorderBrush" Value="{StaticResource ThemeAccent}"/></Trigger>
       <Trigger Property="IsPressed" Value="True"><Setter TargetName="Disc" Property="Background" Value="#EAF0F6"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Button.Template>
    <Button.ToolTip>
     <ToolTip Placement="Top" FontFamily="{StaticResource UiFont}" Padding="10,7" MaxWidth="360">
      <StackPanel>
       <TextBlock x:Name="StatusTitle" Text="正在读取同步状态" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
       <TextBlock x:Name="StatusDetail" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
      </StackPanel>
     </ToolTip>
    </Button.ToolTip>
    <Path x:Name="StatusSymbol" Width="24" Height="24" Stretch="None" RenderTransformOrigin=".5,.5"
          Stroke="{StaticResource ThemeAccent}" StrokeThickness="1.65" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
          Data="{StaticResource Glyph-sync}"/>
   </Button>
  </Grid>
 </Border>
</Window>
