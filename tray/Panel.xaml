<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="115Drive 同步进度" Width="384" Height="664" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" ResizeMode="NoResize" Topmost="True" FontFamily="Microsoft YaHei UI" FontSize="13" UseLayoutRounding="True">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="#26364D"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,8"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="#E9F0FA"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="#DCE8F8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Border Margin="12" Background="#FCFDFE" CornerRadius="14" BorderBrush="#DCE2EA" BorderThickness="1">
  <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.17"/></Border.Effect>
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="64"/></Grid.RowDefinitions>
   <Grid Margin="16,8,12,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition/><ColumnDefinition Width="36"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
    <Image x:Name="BrandIcon" Width="34" Height="34" HorizontalAlignment="Left" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="115Drive" FontSize="17" FontWeight="SemiBold" Foreground="#1D2C41"/><TextBlock Text="115 网盘 · 双向同步" FontSize="11" Foreground="#758396" Margin="0,2,0,0"/></StackPanel>
    <Button x:Name="SettingsButton" Grid.Column="2" Content="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" ToolTip="连接与设置" Padding="8"/>
    <Button x:Name="CloseButton" Grid.Column="3" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11" ToolTip="收起" Padding="7"/>
   </Grid>
   <Border Grid.Row="1" Margin="21,7,21,0" Height="24" Padding="0" Background="Transparent" CornerRadius="6" x:Name="StatusCard">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock x:Name="StatusSymbol" Text="✓" FontSize="15" Width="17" Height="21" TextAlignment="Center" HorizontalAlignment="Left" Foreground="#287B56" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/><TextBlock x:Name="StatusTitle" Grid.Column="1" Text="正在读取同步状态" FontSize="12" Foreground="#235A46" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></Grid>
   </Border>
   <Grid Grid.Row="2" Margin="0,16,0,0">
    <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition/></Grid.RowDefinitions>
    <DockPanel Margin="22,0,22,0"><TextBlock Text="最近活动" Foreground="#6A788B" FontSize="11" FontWeight="SemiBold"/><TextBlock x:Name="LastSyncLabel" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="10" Foreground="#8B96A6"/></DockPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="ActivityList" Margin="9,0,9,4"/></ScrollViewer>
   </Grid>
   <Border Grid.Row="3" Background="#F3F6FA" CornerRadius="0,0,14,14" BorderBrush="#DCE2EA" BorderThickness="0,1,0,0">
    <UniformGrid Columns="3" Margin="7,7">
     <Button x:Name="FolderButton"><StackPanel><TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="17" HorizontalAlignment="Center"/><TextBlock Text="打开文件夹" FontSize="10" Margin="0,5,0,0"/></StackPanel></Button>
     <Button x:Name="SyncButton"><StackPanel><TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="17" HorizontalAlignment="Center"/><TextBlock Text="立即同步" FontSize="10" Margin="0,5,0,0"/></StackPanel></Button>
     <Button x:Name="PauseButton"><StackPanel><TextBlock x:Name="PauseGlyph" Text="&#xE769;" FontFamily="Segoe MDL2 Assets" FontSize="17" HorizontalAlignment="Center"/><TextBlock x:Name="PauseLabel" Text="暂停同步" FontSize="10" Margin="0,5,0,0"/></StackPanel></Button>
    </UniformGrid>
   </Border>
  </Grid>
 </Border>
</Window>
