<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="115Drive 同步进度" Width="384" Height="664" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" ResizeMode="NoResize" Topmost="True" FontFamily="Microsoft YaHei UI" FontSize="13" UseLayoutRounding="True">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="#375F83"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,8"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="#F0F3F7"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="#E2EAF2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ChromeButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Foreground" Value="#375F83"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ChromeSurface" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ChromeSurface" Property="Background" Value="#E8EFF6"/><Setter Property="Foreground" Value="#375F83"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ChromeSurface" Property="Background" Value="#DCE6F0"/><Setter Property="Foreground" Value="#375F83"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ToolTip"><Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="#243247"/><Setter Property="BorderBrush" Value="#E2E6EB"/></Style>
  <Style TargetType="ContextMenu"><Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="#243247"/><Setter Property="BorderBrush" Value="#E2E6EB"/></Style>
  <Style x:Key="ActionIcon" TargetType="Path"><Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/><Setter Property="StrokeThickness" Value="1.7"/><Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/><Setter Property="StrokeLineJoin" Value="Round"/><Setter Property="Width" Value="22"/><Setter Property="Height" Value="22"/><Setter Property="HorizontalAlignment" Value="Center"/></Style>
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Border Background="Transparent" Padding="2,0"><Track x:Name="PART_Track" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.Thumb><Thumb MinHeight="28"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="ThumbSurface" Background="#CBD3DD" CornerRadius="3"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbSurface" Property="Background" Value="#96A5B6"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbSurface" Property="Background" Value="#72859B"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton></Track></Border></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Border Margin="12" Background="#FFFFFF" CornerRadius="14" BorderBrush="#E2E6EB" BorderThickness="1">
  <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.13"/></Border.Effect>
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="64"/></Grid.RowDefinitions>
   <Border Grid.Row="0" Background="#F7F8FA" CornerRadius="13,13,0,0" BorderBrush="#E2E6EB" BorderThickness="0,0,0,1"><Grid>
    <Grid Margin="16,5,12,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition/><ColumnDefinition Width="36"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
    <Image x:Name="BrandIcon" Width="42" Height="42" HorizontalAlignment="Left" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="115Drive" FontSize="17" FontWeight="SemiBold" Foreground="#375F83"/><TextBlock Text="115 网盘 · 双向同步" FontSize="11" Foreground="#596779" Margin="0,2,0,0"/></StackPanel>
    <Button Style="{StaticResource ChromeButton}" x:Name="SettingsButton" Grid.Column="2" ToolTip="连接与设置" AutomationProperties.Name="连接与设置" Padding="7"><Path Style="{StaticResource ActionIcon}" Width="22" Height="22" Data="M 9 2 L 13 2 L 13.7 4.5 L 15.3 5.4 L 17.8 4.8 L 19.8 8.2 L 18 10 L 18 12 L 19.8 13.8 L 17.8 17.2 L 15.3 16.6 L 13.7 17.5 L 13 20 L 9 20 L 8.3 17.5 L 6.7 16.6 L 4.2 17.2 L 2.2 13.8 L 4 12 L 4 10 L 2.2 8.2 L 4.2 4.8 L 6.7 5.4 L 8.3 4.5 Z M 14 11 A 3 3 0 1 1 8 11 A 3 3 0 1 1 14 11"/></Button>
    <Button Style="{StaticResource ChromeButton}" x:Name="CloseButton" Grid.Column="3" ToolTip="收起" AutomationProperties.Name="收起" Padding="7"><Path Style="{StaticResource ActionIcon}" Width="16" Height="16" StrokeThickness="1.5" Data="M 3 3 L 13 13 M 13 3 L 3 13"/></Button>
   </Grid></Grid></Border>
   <Border Grid.Row="1" Margin="21,7,21,0" Height="24" Padding="0" Background="Transparent" CornerRadius="6" x:Name="StatusCard">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock x:Name="StatusSymbol" Text="✓" FontSize="15" Width="17" Height="21" TextAlignment="Center" HorizontalAlignment="Left" Foreground="#287B56" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/><TextBlock x:Name="StatusTitle" Grid.Column="1" Text="正在读取同步状态" FontSize="12" Foreground="#243247" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></Grid>
   </Border>
   <Grid Grid.Row="2" Margin="0,16,0,0">
    <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition/></Grid.RowDefinitions>
    <DockPanel Margin="22,0,22,0"><TextBlock Text="最近活动" Foreground="#243247" FontSize="11" FontWeight="SemiBold"/><TextBlock x:Name="LastSyncLabel" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="10" Foreground="#667385"/></DockPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="ActivityList" Margin="9,0,9,4"/></ScrollViewer>
   </Grid>
   <Border Grid.Row="3" Background="#F7F8FA" CornerRadius="0,0,13,13" BorderBrush="#E2E6EB" BorderThickness="0,1,0,0">
    <UniformGrid Columns="3" Margin="7,7">
     <Button Style="{StaticResource ChromeButton}" x:Name="FolderButton" Padding="8,4" AutomationProperties.Name="打开文件夹"><StackPanel><Path Style="{StaticResource ActionIcon}" Data="M 2 18 L 2 5 Q 2 3 4 3 L 8 3 L 10 6 L 18 6 Q 20 6 20 8 L 20 10 M 2 18 L 5 10 L 21 10 L 18 18 Z"/><TextBlock Text="打开文件夹" FontSize="10" Margin="0,4,0,0"/></StackPanel></Button>
     <Button Style="{StaticResource ChromeButton}" x:Name="SyncButton" Padding="8,4" AutomationProperties.Name="立即同步"><StackPanel><Path Style="{StaticResource ActionIcon}" Data="M 18 7 A 7.5 7.5 0 0 0 4 8 M 18 2 L 18 7 L 13 7 M 4 15 A 7.5 7.5 0 0 0 18 14 M 4 20 L 4 15 L 9 15"/><TextBlock Text="立即同步" FontSize="10" Margin="0,4,0,0"/></StackPanel></Button>
     <Button Style="{StaticResource ChromeButton}" x:Name="PauseButton" Padding="8,4"><StackPanel><Path x:Name="PauseGlyph" Style="{StaticResource ActionIcon}" StrokeThickness="2.2" Data="M 7 4 L 7 18 M 15 4 L 15 18"/><TextBlock x:Name="PauseLabel" Text="暂停同步" FontSize="10" Margin="0,4,0,0"/></StackPanel></Button>
    </UniformGrid>
   </Border>
  </Grid>
 </Border>
</Window>
