<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="115Drive 设置" Width="800" Height="610" MinWidth="710" MinHeight="530" WindowStartupLocation="CenterScreen" Background="#F7F8FA" FontFamily="Microsoft YaHei UI" FontSize="13" UseLayoutRounding="True">
 <Window.Resources>
  <Style TargetType="TextBox"><Setter Property="BorderBrush" Value="#C5CED8"/><Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="#243247"/><Setter Property="SelectionBrush" Value="#DCE9F5"/></Style>
  <Style TargetType="Button"><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="15,9"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="#F0F3F7"/><Setter Property="Foreground" Value="#375F83"/><Setter Property="BorderBrush" Value="#D8DFE7"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="TaskDeleteButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Foreground" Value="#B3261E"/><Setter Property="Background" Value="#FFF1F0"/><Setter Property="BorderBrush" Value="#E6BBB6"/><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#7B8490"/><Setter Property="Background" Value="#ECEFF3"/><Setter Property="BorderBrush" Value="#D8DFE7"/><Setter Property="Cursor" Value="Arrow"/></Trigger></Style.Triggers></Style>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#243247"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Note" TargetType="TextBlock"><Setter Property="Foreground" Value="#596779"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="20"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#E2E6EB"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="18"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
  <Style x:Key="TaskTitle" TargetType="TextBlock"><Setter Property="Foreground" Value="#375F83"/><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="PolicyBadge" TargetType="Border"><Setter Property="Background" Value="#E8EFF6"/><Setter Property="CornerRadius" Value="5"/><Setter Property="Padding" Value="8,3"/><Setter Property="Margin" Value="12,0,0,0"/><Setter Property="VerticalAlignment" Value="Top"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#243247"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border x:Name="CheckSurface" Width="17" Height="17" CornerRadius="4" BorderBrush="#9AA8B8" BorderThickness="1" Background="#F7F8FA"><Path x:Name="CheckMark" Data="M 3 8 L 6 11 L 12 4" Stroke="#FFFFFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/></Border><ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckSurface" Property="Background" Value="#375F83"/><Setter TargetName="CheckSurface" Property="BorderBrush" Value="#375F83"/><Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CheckSurface" Property="BorderBrush" Value="#375F83"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid Background="#F7F8FA">
  <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Border Background="#F7F8FA" BorderBrush="#E2E6EB" BorderThickness="0,0,1,0"><Grid>
   <DockPanel Margin="18,25,10,18">
    <StackPanel DockPanel.Dock="Top" Margin="5,0,0,28"><Image x:Name="SettingsBrandIcon" Width="65" Height="55" HorizontalAlignment="Left" Margin="0,0,0,14" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="115Drive" FontSize="22" FontWeight="SemiBold" Foreground="#375F83"/><TextBlock Text="设置" Foreground="#596779" Margin="0,5,0,0"/></StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="5,0,0,0"><TextBlock Text="文件随你，安心同步" Style="{StaticResource Note}"/></StackPanel>
    <StackPanel><Button x:Name="SyncNav" BorderThickness="4,0,0,0" Content="同步与备份" HorizontalContentAlignment="Left" Margin="0,0,0,8"/><Button x:Name="AccountNav" BorderThickness="4,0,0,0" Content="账户" Margin="0,0,0,8"/><Button x:Name="AboutNav" BorderThickness="4,0,0,0" Content="关于" Margin="0,0,0,8"/></StackPanel>
   </DockPanel>
  </Grid></Border>
  <Grid Grid.Column="1" Margin="28,24,28,18">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="13"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,0"><TextBlock x:Name="SettingsTitle" Foreground="#375F83" Text="同步与备份" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="SettingsSubtitle" Text="统一管理同步文件夹、保留策略与启动偏好" Style="{StaticResource Note}" Margin="0,8,0,0"/></StackPanel>
<Border Grid.Row="1" Height="1" Background="#E2E6EB" VerticalAlignment="Bottom"/>
   </Grid>
   <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid>
     <StackPanel x:Name="SyncPage">
      <DockPanel Margin="0,0,0,14"><Button x:Name="ShowAddTask" Content="添加同步任务" DockPanel.Dock="Right" Margin="12,0,0,0" Background="#375F83" Foreground="White"/><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="同步文件夹" Style="{StaticResource TaskTitle}"/><TextBlock x:Name="TaskCountLabel" Style="{StaticResource Note}" Margin="10,0,0,0"/></StackPanel></DockPanel>
      <Border x:Name="LegacyTaskCard" Style="{StaticResource Card}"><StackPanel>
       <DockPanel><Border DockPanel.Dock="Right" Style="{StaticResource PolicyBadge}"><TextBlock Text="始终保留" Foreground="#375F83" FontSize="11"/></Border><TextBlock x:Name="LegacyTaskTitle" Text="115Drive" Style="{StaticResource TaskTitle}"/></DockPanel>
       <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="本地" Style="{StaticResource Note}"/><TextBlock x:Name="LocalFolderLabel" Grid.Column="1" Text="正在读取…"/><TextBlock Grid.Row="1" Text="云端" Style="{StaticResource Note}" Margin="0,5,0,0"/><TextBlock x:Name="LegacyCloudLabel" Grid.Row="1" Grid.Column="1" Text="/115Drive" Margin="0,5,0,0"/></Grid>
       <TextBlock x:Name="SyncStateLabel" Text="正在读取状态…" Style="{StaticResource Note}" Margin="0,10,0,0"/>
       <WrapPanel Margin="0,12,0,0"><Button x:Name="SettingsOpenFolder" Content="打开文件夹" Margin="0,0,8,6"/><Button x:Name="ChangeFolderButton" Content="更改位置" Margin="0,0,8,6"/><Button x:Name="SettingsPauseButton" Content="暂停任务" Margin="0,0,8,6"/></WrapPanel>
       <TextBlock Text="删除和覆盖会同步到另一端，冲突版本单独保留。" Style="{StaticResource Note}" FontSize="11" LineHeight="17" Margin="0,4,0,0"/>
       <StackPanel x:Name="FolderEditor" Visibility="Collapsed" Margin="0,16,0,0"><TextBlock Text="新位置（空文件夹或尚未创建的文件夹）" Style="{StaticResource Note}"/><TextBox x:Name="NewFolderPath" Padding="10" Margin="0,7,0,10" FontSize="12"/><StackPanel Orientation="Horizontal"><Button x:Name="BrowseFolderButton" Content="浏览…"/><Button x:Name="CheckFolderButton" Content="检查目标"/><Button x:Name="ApplyFolderButton" Content="复制并切换" Background="#375F83" Foreground="White" IsEnabled="False"/></StackPanel>
        <TextBlock x:Name="FolderResult" Style="{StaticResource Note}" Margin="0,12,0,0"/>
        <ProgressBar x:Name="FolderProgress" Height="5" Margin="0,12,0,0" Visibility="Collapsed" Foreground="#375F83"/>
        <Button x:Name="CancelFolderButton" Content="取消更改" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,10,0,0"/>
        <TextBlock Text="复制并校验后切换；旧目录保留为副本。复制期间请关闭正在编辑的同步文件。" Style="{StaticResource Note}" Margin="0,12,0,0"/>
       </StackPanel>
      </StackPanel></Border>
      <StackPanel x:Name="TaskCards"/>
      <Border x:Name="AddTaskPanel" Style="{StaticResource Card}" Visibility="Collapsed"><StackPanel>
       <TextBlock Text="添加同步任务" FontSize="16" FontWeight="SemiBold"/>
       <TextBlock Text="任务名称" Style="{StaticResource Note}" Margin="0,12,0,4"/><TextBox x:Name="NewTaskName" Padding="8"/>
       <TextBlock Text="本地文件夹" Style="{StaticResource Note}" Margin="0,12,0,4"/><DockPanel><Button x:Name="BrowseTaskFolder" Content="浏览…" DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBox x:Name="NewTaskLocal" Padding="8"/></DockPanel>
       <TextBlock Text="云端文件夹（例如 /工作资料，请先在网盘建立）" Style="{StaticResource Note}" Margin="0,12,0,4"/><TextBox x:Name="NewTaskCloud" Padding="8"/>
       <TextBlock Text="默认保留策略" Style="{StaticResource Note}" Margin="0,12,0,4"/><ComboBox x:Name="NewTaskPolicy" SelectedIndex="0" Padding="8"><ComboBoxItem Content="始终保留 · 自动下载全部内容"/><ComboBoxItem Content="仅联机 · 打开时下载"/></ComboBox>
       <TextBlock Text="保存后点击“启动任务”开始同步。文件夹不能与其他任务重叠。新任务保留云端替换和删除历史，会占用网盘空间。" Style="{StaticResource Note}" Margin="0,12,0,10"/>
       <WrapPanel><Button x:Name="CreateTaskButton" Content="保存任务" Background="#375F83" Foreground="White"/><Button x:Name="CancelAddTask" Content="取消"/></WrapPanel>
      </StackPanel></Border>
      <Border x:Name="EditTaskPanel" Style="{StaticResource Card}" Visibility="Collapsed"><StackPanel>
       <DockPanel><Button x:Name="CloseTaskPolicy" Content="收起" DockPanel.Dock="Right" Margin="12,0,0,0"/><TextBlock x:Name="EditTaskTitle" Style="{StaticResource TaskTitle}" VerticalAlignment="Center"/></DockPanel>
       <TextBlock Text="默认保留策略" Style="{StaticResource Note}" Margin="0,12,0,4"/><ComboBox x:Name="EditTaskPolicy" Padding="8"><ComboBoxItem Content="始终保留"/><ComboBoxItem Content="仅联机"/></ComboBox>
       <TextBlock Text="仅联机文件打开后的缓存时间（小时，0 表示闲置后尽快回收）" Style="{StaticResource Note}" Margin="0,12,0,4"/><TextBox x:Name="TaskCacheHours" Padding="8"/>
       <Button x:Name="SaveTaskPolicy" Content="保存默认策略" HorizontalAlignment="Left" Margin="0,12,0,16"/>
       <TextBlock Text="单独设置文件或子文件夹" FontWeight="SemiBold"/>
       <TextBlock x:Name="TaskOverrideSummary" Style="{StaticResource Note}" Margin="0,8,0,4"/>
       <TextBlock Text="相对于任务目录的路径，例如 资料/重要文档.pdf" Style="{StaticResource Note}" Margin="0,8,0,4"/><TextBox x:Name="TaskOverridePath" Padding="8"/>
       <ComboBox x:Name="TaskOverridePolicy" Padding="8" Margin="0,8,0,8" SelectedIndex="0"><ComboBoxItem Content="继承文件夹及任务默认值"/><ComboBoxItem Content="始终保留"/><ComboBoxItem Content="仅联机"/></ComboBox>
       <Button x:Name="SaveTaskOverride" Content="应用到此路径" HorizontalAlignment="Left"/>
       <TextBlock Text="手动例外优先于任务默认值。未上传、冲突及正在使用的文件不会自动释放。" Style="{StaticResource Note}" Margin="0,12,0,0"/>
      </StackPanel></Border>
      <Border x:Name="CommonPreferencesCard" Style="{StaticResource Card}"><StackPanel><TextBlock Text="通用偏好" Style="{StaticResource TaskTitle}"/><CheckBox x:Name="StartupCheck" Content="登录 Windows 时自动启动 115Drive" Margin="0,14,0,0"/></StackPanel></Border>
     </StackPanel>
     <StackPanel x:Name="AccountPage" Visibility="Collapsed">
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Foreground="#375F83" Text="115 网盘" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="AccountStateLabel" Text="正在读取连接状态…" Margin="0,10,0,12"/><TextBlock Text="使用手机 115 生活 App 扫码连接。无需保持官方客户端后台运行。" Style="{StaticResource Note}"/><StackPanel Orientation="Horizontal" Margin="0,16,0,0"><Button x:Name="NativeLoginButton" Content="扫码连接" Background="#375F83" Foreground="White"/><Button x:Name="NativeCancelLogin" Content="取消扫码" Visibility="Collapsed"/><Button x:Name="PauseForLogin" Content="暂停以重新连接" Visibility="Collapsed"/></StackPanel>
       <Image x:Name="LoginQrImage" Width="190" Height="190" HorizontalAlignment="Left" Visibility="Collapsed" Margin="0,16,0,0"/>
       <TextBlock x:Name="LoginMessage" Style="{StaticResource Note}" Margin="0,14,0,0"/>
      </StackPanel></Border>
      <TextBlock Text="登录凭据仅保存在本机受限目录。普通网盘会话可能失效，届时需重新扫码；扫码可能替换已有的微信小程序会话。连接验证会在独立测试目录检查同步，再启用自动同步。" Style="{StaticResource Note}"/>
     </StackPanel>
     <StackPanel x:Name="AboutPage" Visibility="Collapsed"><Image x:Name="AboutBrandIcon" Width="82" Height="70" HorizontalAlignment="Left" Margin="0,0,0,12" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="115Drive" Foreground="#375F83" FontSize="32" FontWeight="SemiBold" Margin="0,5,0,10"/><TextBlock Text="版本 0.3.0-rc1 · Windows x64" Margin="0,0,0,20"/><TextBlock Text="面向 115 网盘的本地双向同步工具。&#10;原生托盘、文件同步进度与设置窗口。" Margin="0,0,0,20"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Foreground="#375F83" Text="由 OpenList 与 rclone 提供同步能力" FontWeight="SemiBold"/><TextBlock Text="社区项目，非 115 官方客户端。新增多任务与文件随选；原有同步任务继续保留完整本地副本。" Style="{StaticResource Note}" Margin="0,10,0,14"/><Button x:Name="OpenRecoveryButton" Content="打开本机恢复目录" HorizontalAlignment="Left"/></StackPanel></Border><TextBlock x:Name="DataFolderLabel" Style="{StaticResource Note}"/></StackPanel>
    </Grid>
   </ScrollViewer>
   <TextBlock x:Name="SettingsNotice" Grid.Row="2" Style="{StaticResource Note}" Margin="0,14,0,0" MaxHeight="60"/>
  </Grid>
 </Grid>
</Window>
