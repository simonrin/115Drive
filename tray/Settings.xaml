<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="115Drive 设置" Width="868" Height="650" MinWidth="710" MinHeight="530" WindowStartupLocation="CenterScreen" Background="#F3F6F9" FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True">
 <Window.Resources>
  <Style TargetType="TextBox">
   <Setter Property="BorderBrush" Value="#B9CAD8"/><Setter Property="Background" Value="#FCFDFE"/>
   <Setter Property="Foreground" Value="#1C334B"/><Setter Property="SelectionBrush" Value="#B7D7EF"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
    <Border x:Name="Input" CornerRadius="5" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
     <ScrollViewer x:Name="PART_ContentHost"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Input" Property="BorderBrush" Value="{StaticResource ThemeAccent}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".5"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Button">
   <Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,0,8,0"/>
   <Setter Property="Background" Value="#F6F9FC"/><Setter Property="Foreground" Value="#294D6A"/><Setter Property="BorderBrush" Value="#CFDCE6"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Grid>
     <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"/>
     <Border x:Name="Hover" Background="{TemplateBinding Foreground}" Opacity="0" CornerRadius="6"/>
     <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value=".07"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Hover" Property="Opacity" Value=".14"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".55"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Navigation" TargetType="Button">
   <Setter Property="Foreground" Value="#D2E2EF"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Background" Value="Transparent"/><Setter Property="Height" Value="41"/><Setter Property="Margin" Value="0,0,0,5"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Grid>
       <Border Background="{TemplateBinding Background}" CornerRadius="7"/>
       <Border x:Name="Hover" Background="White" Opacity="0" CornerRadius="7"/>
       <Border x:Name="Accent" Width="3" Height="16" HorizontalAlignment="Left" Background="#9BD3EF" CornerRadius="2" Visibility="Collapsed"/>
       <StackPanel Orientation="Horizontal" Margin="15,0" VerticalAlignment="Center">
        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{TemplateBinding Foreground}" Text="{TemplateBinding Tag}" VerticalAlignment="Center" Width="29"/>
        <ContentPresenter VerticalAlignment="Center"/>
       </StackPanel>
      </Grid>
      <ControlTemplate.Triggers>
       <Trigger Property="Selector.IsSelected" Value="True"><Setter TargetName="Accent" Property="Visibility" Value="Visible"/></Trigger>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value=".08"/></Trigger>
       <Trigger Property="IsPressed" Value="True"><Setter TargetName="Hover" Property="Opacity" Value=".15"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
   <Style.Triggers>
    <Trigger Property="Selector.IsSelected" Value="True">
     <Setter Property="Background" Value="#284C6E"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/>
    </Trigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="TaskDeleteMenu" TargetType="MenuItem"><Setter Property="Foreground" Value="#B3261E"/><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#7B8490"/></Trigger></Style.Triggers></Style>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#1C334B"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Note" TargetType="TextBlock"><Setter Property="Foreground" Value="#516578"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="20"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#D9E3EC"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="17,14"/><Setter Property="Margin" Value="0,0,0,11"/></Style>
  <Style x:Key="TaskTitle" TargetType="TextBlock"><Setter Property="Foreground" Value="#193951"/><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="PolicyBadge" TargetType="Border"><Setter Property="Background" Value="#E7F1FA"/><Setter Property="CornerRadius" Value="5"/><Setter Property="Padding" Value="8,3"/><Setter Property="Margin" Value="12,0,0,0"/><Setter Property="VerticalAlignment" Value="Top"/></Style>
  <DataTemplate x:Key="SyncFolderRow">
   <Border BorderBrush="#E2E9EF" BorderThickness="0,0,0,1" Padding="13,8" MinHeight="60" SnapsToDevicePixels="True">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Button x:Name="OpenTask" Grid.Column="0" Width="33" Height="33" Padding="0" Margin="0,0,11,0" VerticalAlignment="Center" Background="#EAF2FA" BorderThickness="0" ToolTip="打开本地文件夹">
      <Grid Width="20" Height="18"><Path Data="M2,5 L2,4 Q2,2.5 3.5,2.5 L8,2.5 L10,5 L16.5,5 Q18,5 18,6.5 L18,14.5 Q18,16 16.5,16 L3.5,16 Q2,16 2,14.5 Z" Fill="#D8E9F8" Stroke="{StaticResource ThemeAccent}" StrokeThickness="1.4" StrokeLineJoin="Round"/><Path Data="M2.5,7 L17.5,7" Stroke="{StaticResource ThemeAccent}" StrokeThickness="1.2"/></Grid>
     </Button>
     <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
      <TextBlock x:Name="RowTitle" FontSize="14" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
      <Grid x:Name="RowPaths" Margin="0,3,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <TextBlock x:Name="LocalPathText" FontSize="11.5" Foreground="#516578" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
       <TextBlock x:Name="CloudPathText" Grid.Column="1" FontSize="11.5" Foreground="#516578" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
      </Grid>
      <TextBlock x:Name="RowIssue" Margin="0,4,0,0" FontSize="12" Foreground="#9B333E" TextWrapping="Wrap" Visibility="Collapsed"/>
     </StackPanel>
     <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
      <StackPanel x:Name="RowState" Orientation="Horizontal" HorizontalAlignment="Center">
       <Ellipse x:Name="StateDot" Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center"/>
       <TextBlock x:Name="StateText" FontSize="12" FontWeight="SemiBold"/>
      </StackPanel>
      <Button x:Name="RowPolicy" Margin="0,1,0,0" Padding="5,1" FontSize="11.5" Foreground="#536B80" Background="Transparent" BorderThickness="0" ToolTip="更改保留策略"/>
     </StackPanel>
     <Button x:Name="MoreTask" Grid.Column="3" Width="28" Height="28" Margin="7,0,0,0" Padding="0" VerticalAlignment="Center" Background="Transparent" Foreground="#526B80" BorderThickness="0" FontFamily="Segoe MDL2 Assets" FontSize="15" Content="&#xE712;" ToolTip="更多操作">
      <Button.ContextMenu>
       <ContextMenu FontFamily="{StaticResource UiFont}" FontSize="13" Placement="Bottom">
        <MenuItem Header="打开文件夹" Tag="open"/><MenuItem Header="保留策略" Tag="policy"/>
        <Separator/><MenuItem Tag="toggle"/><MenuItem Header="删除任务" Tag="delete" Style="{StaticResource TaskDeleteMenu}" ToolTipService.ShowOnDisabled="True"/>
       </ContextMenu>
      </Button.ContextMenu>
     </Button>
    </Grid>
   </Border>
  </DataTemplate>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#1C334B"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border x:Name="CheckSurface" Width="17" Height="17" CornerRadius="4" BorderBrush="#9AA8B8" BorderThickness="1" Background="#F3F6F9"><Path x:Name="CheckMark" Data="M 3 8 L 6 11 L 12 4" Stroke="#FFFFFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/></Border><ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckSurface" Property="Background" Value="{StaticResource ThemeAccent}"/><Setter TargetName="CheckSurface" Property="BorderBrush" Value="{StaticResource ThemeAccent}"/><Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CheckSurface" Property="BorderBrush" Value="{StaticResource ThemeAccent}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid Background="#F3F6F9">
  <Grid.ColumnDefinitions><ColumnDefinition Width="152"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Border>
   <Border.Background>
    <StaticResource ResourceKey="ThemeAccent"/>
   </Border.Background>
   <Grid ClipToBounds="True">
    <StackPanel Margin="10,21,10,0">
     <StackPanel Orientation="Horizontal" Margin="3,0,0,23">
      <Border Width="33" Height="33" CornerRadius="8" Background="#F6FAFF" VerticalAlignment="Center">
       <Image x:Name="SettingsBrandIcon" Width="27" Height="27" RenderOptions.BitmapScalingMode="HighQuality"/>
      </Border>
      <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
       <TextBlock x:Name="BrandTitle" Text="115Drive" FontFamily="{StaticResource BrandFont}" FontSize="19" FontWeight="SemiBold" Foreground="White"/>
       <TextBlock Text="设置" FontSize="11" Foreground="#C3D6E6"/>
      </StackPanel>
     </StackPanel>
     <Button x:Name="SyncNav" Style="{StaticResource Navigation}" Content="同步与备份" Tag="&#xE895;"/>
     <Button x:Name="AccountNav" Style="{StaticResource Navigation}" Content="账户" Tag="&#xE77B;"/>
     <Button x:Name="AboutNav" Style="{StaticResource Navigation}" Content="关于" Tag="&#xE946;"/>
    </StackPanel>
   </Grid>
  </Border>
   <Grid Grid.Column="1" Margin="22,18,16,12">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Margin="0,0,0,13">
    <TextBlock x:Name="SettingsTitle" Text="同步与备份" FontSize="26" FontWeight="SemiBold" Foreground="#17334F"/>
     <TextBlock x:Name="SettingsSubtitle" Style="{StaticResource Note}" Margin="0,5,0,0" Visibility="Collapsed"/>
   </StackPanel>
   <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="0,0,6,0">
     <StackPanel x:Name="SyncPage">
       <DockPanel Margin="0,0,0,9"><Button x:Name="ShowAddTask" AutomationProperties.Name="添加同步任务" Content="＋ 添加任务" DockPanel.Dock="Right" Padding="12,5" Margin="12,0,0,0" Background="{StaticResource ThemeAccent}" Foreground="White" BorderThickness="0"/><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="同步文件夹" Style="{StaticResource TaskTitle}"/><TextBlock x:Name="TaskCountLabel" Style="{StaticResource Note}" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel></DockPanel>
      <Border x:Name="LegacyTaskCard" Style="{StaticResource Card}"><StackPanel>
       <DockPanel><Border DockPanel.Dock="Right" Style="{StaticResource PolicyBadge}" Background="#E8F4EE"><TextBlock Text="始终保留" Foreground="#21684E" FontSize="11"/></Border><TextBlock x:Name="LegacyTaskTitle" Text="115Drive" Style="{StaticResource TaskTitle}"/></DockPanel>
       <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="本地" Style="{StaticResource Note}"/><TextBlock x:Name="LocalFolderLabel" Grid.Column="1" Text="正在读取…"/><TextBlock Grid.Row="1" Text="云端" Style="{StaticResource Note}" Margin="0,5,0,0"/><TextBlock x:Name="LegacyCloudLabel" Grid.Row="1" Grid.Column="1" Text="/115Drive" Margin="0,5,0,0"/></Grid>
       <TextBlock x:Name="SyncStateLabel" Text="正在读取状态…" Style="{StaticResource Note}" Margin="0,10,0,0"/>
       <WrapPanel Margin="0,12,0,0"><Button x:Name="SettingsOpenFolder" Content="打开文件夹" Margin="0,0,8,6"/><Button x:Name="ChangeFolderButton" Content="更改位置" Margin="0,0,8,6"/><Button x:Name="SettingsPauseButton" Content="暂停任务" Margin="0,0,8,6"/></WrapPanel>
       <TextBlock Text="删除和覆盖会同步到另一端，冲突版本单独保留。" Style="{StaticResource Note}" FontSize="11" LineHeight="17" Margin="0,4,0,0"/>
       <StackPanel x:Name="FolderEditor" Visibility="Collapsed" Margin="0,16,0,0"><TextBlock Text="新位置（空文件夹或尚未创建的文件夹）" Style="{StaticResource Note}"/><TextBox x:Name="NewFolderPath" Padding="10" Margin="0,7,0,10" FontSize="12"/><StackPanel Orientation="Horizontal"><Button x:Name="BrowseFolderButton" Content="浏览…"/><Button x:Name="CheckFolderButton" Content="检查目标"/><Button x:Name="ApplyFolderButton" Content="复制并切换" Background="{StaticResource ThemeAccent}" Foreground="White" IsEnabled="False"/></StackPanel>
        <TextBlock x:Name="FolderResult" Style="{StaticResource Note}" Margin="0,12,0,0"/>
        <ProgressBar x:Name="FolderProgress" Height="5" Margin="0,12,0,0" Visibility="Collapsed" Foreground="{StaticResource ThemeAccent}"/>
        <Button x:Name="CancelFolderButton" Content="取消更改" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,10,0,0"/>
        <TextBlock Text="复制并校验后切换；旧目录保留为副本。复制期间请关闭正在编辑的同步文件。" Style="{StaticResource Note}" Margin="0,12,0,0"/>
       </StackPanel>
      </StackPanel></Border>
      <TextBlock x:Name="TaskListMessage" Style="{StaticResource Note}" Visibility="Collapsed" Margin="0,0,0,9"/>
      <Border x:Name="TaskListFrame" Background="White" BorderBrush="#D5E1EA" BorderThickness="1" CornerRadius="9" Margin="0,0,0,12" Visibility="Collapsed"><StackPanel x:Name="TaskCards"/></Border>
      <Border x:Name="AddTaskPanel" Style="{StaticResource Card}" Visibility="Collapsed"><StackPanel>
       <TextBlock Text="添加同步任务" FontSize="16" FontWeight="SemiBold"/>
       <TextBlock Text="任务名称" Style="{StaticResource Note}" Margin="0,12,0,4"/><TextBox x:Name="NewTaskName" Padding="8"/>
       <TextBlock Text="本地文件夹" Style="{StaticResource Note}" Margin="0,12,0,4"/><DockPanel><Button x:Name="BrowseTaskFolder" Content="浏览…" DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBox x:Name="NewTaskLocal" Padding="8"/></DockPanel>
       <TextBlock Text="云端文件夹（例如 /工作资料，请先在网盘建立）" Style="{StaticResource Note}" Margin="0,12,0,4"/><TextBox x:Name="NewTaskCloud" Padding="8"/>
       <TextBlock Text="默认保留策略" Style="{StaticResource Note}" Margin="0,12,0,4"/><ComboBox x:Name="NewTaskPolicy" SelectedIndex="0" Padding="8"><ComboBoxItem Content="始终保留 · 自动下载全部内容"/><ComboBoxItem Content="仅联机 · 打开时下载"/></ComboBox>
       <TextBlock Text="保存后，在任务的更多操作中启动同步。请选择与其他任务互不重叠的文件夹。" Style="{StaticResource Note}" Margin="0,12,0,10"/>
       <WrapPanel><Button x:Name="CreateTaskButton" Content="保存任务" Background="{StaticResource ThemeAccent}" Foreground="White"/><Button x:Name="CancelAddTask" Content="取消"/></WrapPanel>
      </StackPanel></Border>
      <Border x:Name="EditTaskPanel" Style="{StaticResource Card}" Visibility="Collapsed"><StackPanel>
       <DockPanel><Button x:Name="CloseTaskPolicy" Content="收起" DockPanel.Dock="Right" Margin="12,0,0,0"/><TextBlock x:Name="EditTaskTitle" Style="{StaticResource TaskTitle}" VerticalAlignment="Center"/></DockPanel>
       <TextBlock Text="默认保留策略" Style="{StaticResource Note}" Margin="0,12,0,4"/><ComboBox x:Name="EditTaskPolicy" Padding="8"><ComboBoxItem Content="始终保留"/><ComboBoxItem Content="仅联机"/></ComboBox>
       <TextBlock Text="仅联机文件打开后的缓存时间（小时，0 表示闲置后尽快回收）" Style="{StaticResource Note}" Margin="0,12,0,4"/><TextBox x:Name="TaskCacheHours" Padding="8"/>
       <Button x:Name="SaveTaskPolicy" Content="保存默认策略" HorizontalAlignment="Left" Margin="0,12,0,16"/>
       <TextBlock Text="单独设置文件或子文件夹" FontWeight="SemiBold"/>
       <TextBlock x:Name="TaskOverrideSummary" Style="{StaticResource Note}" Margin="0,8,0,4"/>
       <TextBlock Text="相对于任务目录的路径，例如 资料/重要文档.pdf" Style="{StaticResource Note}" Margin="0,8,0,4"/><TextBox x:Name="TaskOverridePath" Padding="8"/>
       <ComboBox x:Name="TaskOverridePolicy" Padding="8" Margin="0,8,0,8" SelectedIndex="0"><ComboBoxItem Content="继承文件夹及任务默认值"/><ComboBoxItem Content="始终保留"/><ComboBoxItem Content="仅联机"/></ComboBox>
       <Button x:Name="SaveTaskOverride" Content="应用到此路径" HorizontalAlignment="Left"/>
       <TextBlock Text="手动例外优先于任务默认值。未上传、冲突及正在使用的文件不会自动释放。" Style="{StaticResource Note}" Margin="0,12,0,0"/>
      </StackPanel></Border>
      <Border x:Name="CommonPreferencesCard" Style="{StaticResource Card}" Padding="14,10" Margin="0"><DockPanel><TextBlock Text="启动偏好" Style="{StaticResource TaskTitle}" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0"/><CheckBox x:Name="StartupCheck" Content="登录 Windows 时自动启动 115Drive" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel></Border>
     </StackPanel>
     <StackPanel x:Name="AccountPage" Visibility="Collapsed">
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Foreground="{StaticResource ThemeAccent}" Text="115 网盘" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="AccountStateLabel" Text="正在读取连接状态…" Margin="0,10,0,12"/><TextBlock Text="使用手机 115 生活 App 扫码连接。无需保持官方客户端后台运行。" Style="{StaticResource Note}"/><StackPanel Orientation="Horizontal" Margin="0,16,0,0"><Button x:Name="NativeLoginButton" Content="扫码连接" Background="{StaticResource ThemeAccent}" Foreground="White"/><Button x:Name="NativeCancelLogin" Content="取消扫码" Visibility="Collapsed"/><Button x:Name="PauseForLogin" Content="暂停以重新连接" Visibility="Collapsed"/></StackPanel>
       <Image x:Name="LoginQrImage" Width="190" Height="190" HorizontalAlignment="Left" Visibility="Collapsed" Margin="0,16,0,0"/>
       <TextBlock x:Name="LoginMessage" Style="{StaticResource Note}" Margin="0,14,0,0"/>
      </StackPanel></Border>
      <TextBlock Text="登录凭据仅保存在本机受限目录。普通网盘会话可能失效，届时需重新扫码；扫码可能替换已有的微信小程序会话。连接验证会在独立测试目录检查同步，再启用自动同步。" Style="{StaticResource Note}"/>
     </StackPanel>
     <StackPanel x:Name="AboutPage" Visibility="Collapsed"><Image x:Name="AboutBrandIcon" Width="82" Height="70" HorizontalAlignment="Left" Margin="0,0,0,12" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="115Drive" Foreground="{StaticResource ThemeAccent}" FontSize="32" FontWeight="SemiBold" Margin="0,5,0,10"/><TextBlock Text="版本 1.0.2 · Windows x64" Margin="0,0,0,20"/><TextBlock Text="面向 115 网盘的本地双向同步工具。&#10;原生托盘、文件同步进度与设置窗口。" Margin="0,0,0,20"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Foreground="{StaticResource ThemeAccent}" Text="由 OpenList 与 rclone 提供同步能力" FontWeight="SemiBold"/><TextBlock Text="社区项目，非 115 官方客户端。新增多任务与文件随选；原有同步任务继续保留完整本地副本。" Style="{StaticResource Note}" Margin="0,10,0,14"/><Button x:Name="OpenRecoveryButton" Content="打开本机恢复目录" HorizontalAlignment="Left"/></StackPanel></Border><TextBlock x:Name="DataFolderLabel" Style="{StaticResource Note}"/></StackPanel>
    </Grid>
   </ScrollViewer>
   <TextBlock x:Name="SettingsNotice" Grid.Row="2" Style="{StaticResource Note}" Margin="0,14,0,0" MaxHeight="60"/>
  </Grid>
 </Grid>
</Window>
