+func shortSecretFixture(t *testing.T) (*EcdhCipher, []byte) {
+	t.Helper()
+	curve := elliptic.P224()
+	rx := new(big.Int).SetBytes(remotePubKey[:28])
+	ry := new(big.Int).SetBytes(remotePubKey[28:])
+	for n := int64(1); n < 10000; n++ {
+		scalar := big.NewInt(n).Bytes()
+		shared, _ := curve.ScalarMult(rx, ry, scalar)
+		if len(shared.Bytes()) != 27 {
+			continue
+		}
+		x, y := curve.ScalarBaseMult(scalar)
+		public := make([]byte, 30)
+		public[0], public[1] = 29, 2+byte(y.Bit(0))
+		x.FillBytes(public[2:])
+		secret := shared.FillBytes(make([]byte, 28))
+		return &EcdhCipher{key: secret[:16], iv: secret[12:], pubKey: public}, shared.Bytes()
+	}
+	t.Fatal("short secret fixture not found")
