+package op
+
+import (
+	"bytes"
+	"context"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/OpenListTeam/OpenList/v4/internal/driver"
+	"github.com/OpenListTeam/OpenList/v4/internal/model"
+	"github.com/OpenListTeam/OpenList/v4/internal/stream"
+	"github.com/OpenListTeam/OpenList/v4/pkg/utils"
+)
+
+type transactionDriver struct {
+	driver.Driver
+	model.Storage
+	rows map[string]*model.Object
+	fail string
+}
+
+func (d *transactionDriver) GetStorage() *model.Storage { return &d.Storage }
+func (d *transactionDriver) SetStorage(s model.Storage) { d.Storage = s }
+
+func (d *transactionDriver) Config() driver.Config {
+	return driver.Config{Name: "115 Cloud", NoOverwriteUpload: true}
+}
+func (d *transactionDriver) Get(ctx context.Context, p string) (model.Obj, error) {
+	return &model.Object{ID: "parent", Name: "115Drive", IsFolder: true}, nil
+}
+func (d *transactionDriver) List(context.Context, model.Obj, model.ListArgs) ([]model.Obj, error) {
+	if d.fail == "network" {
+		return nil, fmt.Errorf("offline")
+	}
+	var r []model.Obj
+	for _, o := range d.rows {
+		clone := *o
+		r = append(r, &clone)
+	}
+	return r, nil
+}
+func (d *transactionDriver) Rename(_ context.Context, o model.Obj, n string) (model.Obj, error) {
+	for k, v := range d.rows {
+		if v.ID == o.GetID() {
+			delete(d.rows, k)
+			v.Name = n
+			d.rows[n] = v
+			return v, nil
+		}
+	}
+	return nil, fmt.Errorf("missing")
+}
+func (d *transactionDriver) Remove(_ context.Context, o model.Obj) error {
+	if d.fail == "remove" {
+		return fmt.Errorf("offline")
+	}
+	for k, v := range d.rows {
+		if v.ID == o.GetID() {
+			delete(d.rows, k)
+			return nil
+		}
+	}
+	return fmt.Errorf("missing")
+}
+func (d *transactionDriver) Put(_ context.Context, _ model.Obj, f model.FileStreamer, _ driver.UpdateProgress) (model.Obj, error) {
+	if d.fail == "put" {
+		return nil, fmt.Errorf("upload failed")
+	}
+	o := &model.Object{ID: "new", Name: f.GetName(), Size: f.GetSize(), HashInfo: f.GetHash()}
+	d.rows[o.Name] = o
+	return o, nil
+}
+func transactionFixture(t *testing.T) (*transactionDriver, twoDriveIntent, string) {
+	t.Helper()
+	t.Setenv("TWODRIVE_TRANSACTIONS", t.TempDir())
+	d := &transactionDriver{Storage: model.Storage{ID: 123, MountPath: "/115", Remark: "Managed by TwoDrive",
+		Addition: `{"cookie":"UID=123_device_session; CID=unused","root_folder_id":"0"}`}, rows: map[string]*model.Object{}}
+	identity, _ := twoDriveIdentity(d)
+	j := twoDriveIntent{Version: 1, ID: strings.Repeat("a", 32), Identity: identity, Parent: "/115Drive",
+		ParentID: "parent", Name: "原文件.txt", OldID: "old", OldSHA1: utils.HashData(utils.SHA1, []byte("old")),
+		OldSize: 3, NewSHA1: utils.HashData(utils.SHA1, []byte("new")), NewSize: 3}
+	j.Temporary = "twodrive_pending_" + j.ID + ".txt"
+	file, err := twoDriveWrite(j)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return d, j, file
+}
+func oldObject(j twoDriveIntent, name string) *model.Object {
+	return &model.Object{ID: j.OldID, Name: name, Size: j.OldSize, HashInfo: utils.NewHashInfo(utils.SHA1, j.OldSHA1)}
+}
+func newObject(j twoDriveIntent) *model.Object {
+	return &model.Object{ID: "new", Name: j.Name, Size: j.NewSize, HashInfo: utils.NewHashInfo(utils.SHA1, j.NewSHA1)}
+}
+func TestTwoDriveCrashWindows(t *testing.T) {
+	for _, stage := range []string{"before-rename", "after-rename", "after-upload", "after-cleanup"} {
+		t.Run(stage, func(t *testing.T) {
+			d, j, f := transactionFixture(t)
+			switch stage {
+			case "before-rename":
+				d.rows[j.Name] = oldObject(j, j.Name)
+			case "after-rename":
+				d.rows[j.Temporary] = oldObject(j, j.Temporary)
+			case "after-upload":
+				d.rows[j.Temporary] = oldObject(j, j.Temporary)
+				d.rows[j.Name] = newObject(j)
+			case "after-cleanup":
+				d.rows[j.Name] = newObject(j)
+			}
+			// The recovery entrypoint reads the intent from disk, as after restart.
+			if err := twoDriveRecover(context.Background(), d); err != nil {
+				t.Fatal(err)
+			}
+			if len(d.rows) != 1 || d.rows[j.Name] == nil {
+				t.Fatal("incorrect cloud state")
+			}
+			if _, err := os.Stat(f); !os.IsNotExist(err) {
+				t.Fatal("journal retained")
+			}
+			if err := twoDriveRecover(context.Background(), d); err != nil {
+				t.Fatal("not idempotent", err)
+			}
+		})
+	}
+}
+func TestTwoDriveRecoveryRetainsAmbiguousFiles(t *testing.T) {
+	for _, kind := range []string{"changed-final", "changed-temp", "wrong-account", "wrong-parent", "offline", "delete-failure", "corrupt"} {
+		t.Run(kind, func(t *testing.T) {
+			d, j, f := transactionFixture(t)
+			d.rows[j.Temporary] = oldObject(j, j.Temporary)
+			d.rows[j.Name] = newObject(j)
+			switch kind {
+			case "changed-final":
+				d.rows[j.Name].HashInfo = utils.NewHashInfo(utils.SHA1, strings.Repeat("b", 40))
+			case "changed-temp":
+				d.rows[j.Temporary].ID = "someone-else"
+			case "wrong-account":
+				d.Storage.ID++
+			case "wrong-parent":
+				j.ParentID = "changed"
+				data, _ := os.ReadFile(f)
+				os.WriteFile(f, bytes.ReplaceAll(data, []byte(`"parent"`), []byte(`"changed"`)), 0600)
+			case "offline":
+				d.fail = "network"
+			case "delete-failure":
+				d.fail = "remove"
+			case "corrupt":
+				os.WriteFile(f, []byte("{"), 0600)
+			}
+			if err := twoDriveRecover(context.Background(), d); err == nil {
+				t.Fatal("unsafe recovery accepted")
+			}
+			if len(d.rows) != 2 {
+				t.Fatal("changed unknown files")
+			}
+			if _, err := os.Stat(f); err != nil {
+				t.Fatal("lost evidence")
+			}
+		})
+	}
+}
+func TestTwoDriveOverwriteAndRollback(t *testing.T) {
+	for _, fail := range []string{"", "put"} {
+		t.Run("upload-"+fail, func(t *testing.T) {
+			d, j, f := transactionFixture(t)
+			os.Remove(f)
+			d.rows[j.Name] = oldObject(j, j.Name)
+			d.fail = fail
+			input := &stream.FileStream{Obj: &model.Object{Name: j.Name, Size: 3}, Reader: bytes.NewReader([]byte("new"))}
+			err := twoDrivePut(context.Background(), d, "/115Drive", input, nil)
+			if (err != nil) != (fail != "") {
+				t.Fatal(err)
+			}
+			want := "new"
+			if fail != "" {
+				want = "old"
+			}
+			if len(d.rows) != 1 || d.rows[j.Name].ID != want {
+				t.Fatal("lost version")
+			}
+			files, _ := filepath.Glob(filepath.Join(os.Getenv("TWODRIVE_TRANSACTIONS"), "*.json"))
+			if len(files) != 0 {
+				t.Fatal("temporary intent remained")
+			}
+		})
+	}
+}
