+type fakeMultipart struct {
+	parts     []oss.UploadedPart
+	sent      int64
+	failPart  int
+	loseACK   bool
+	initCount int
+	listError error
+}
+
+func TestTwoDriveProductionUserAgent(t *testing.T) {
+	for _, ua := range []string{"TwoDrive/test", "Mozilla/5.0 (Windows NT 10.0; Win64; x64) TwoDrive/1234"} {
+		if !twoDriveUserAgent(ua) {
+			t.Fatal("managed client not recognized", ua)
+		}
+	}
+	if twoDriveUserAgent("rclone/v1.75.1") {
+		t.Fatal("unmanaged client recognized")
+	}
+}
+
+func (b *fakeMultipart) Initiate(_ context.Context, p *driver115.UploadOSSParams) (oss.InitiateMultipartUploadResult, error) {
+	b.initCount++
+	b.parts = nil
+	return oss.InitiateMultipartUploadResult{UploadID: "session", Bucket: p.Bucket, Key: p.Object}, nil
+}
+func (b *fakeMultipart) List(context.Context, oss.InitiateMultipartUploadResult) ([]oss.UploadedPart, error) {
+	return b.parts, b.listError
+}
+func (b *fakeMultipart) Upload(_ context.Context, _ oss.InitiateMultipartUploadResult, _ *driver115.UploadOSSParams, r io.Reader, n int64, num int) (oss.UploadPart, error) {
+	if num == b.failPart && !b.loseACK {
+		return oss.UploadPart{}, errors.New("interrupted")
+	}
+	data, err := io.ReadAll(r)
+	if err != nil {
+		return oss.UploadPart{}, err
+	}
+	b.sent += int64(len(data))
+	sum := md5.Sum(data)
+	part := oss.UploadPart{PartNumber: num, ETag: hex.EncodeToString(sum[:])}
+	b.parts = append(b.parts, oss.UploadedPart{PartNumber: num, ETag: part.ETag, Size: int(n)})
+	if num == b.failPart {
+		return oss.UploadPart{}, errors.New("lost acknowledgement")
+	}
+	return part, nil
+}
+func (b *fakeMultipart) Complete(_ context.Context, _ oss.InitiateMultipartUploadResult, _ *driver115.UploadOSSParams, parts []oss.UploadPart) (*UploadResult, error) {
+	if len(parts) != len(b.parts) {
+		return nil, errors.New("wrong completion parts")
+	}
+	return &UploadResult{}, nil
+}
