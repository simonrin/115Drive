+++ b/OpenList-4.2.6/internal/twodrive_resume/progress.go
@@ -0,0 +1,175 @@
+package twodrive_resume
+
+// Progress is a separate, credential-free view of transfer checkpoints. A UI
+// write must never prevent a transfer or change its recovery decisions.
+import (
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"fmt"
+	"os"
+	"regexp"
+	"sync"
+	"time"
+)
+
+var environmentOnce sync.Once
+var environmentStore *Store
+var environmentError error
+
+func EnvironmentStore() (*Store, error) {
+	environmentOnce.Do(func() {
+		environmentStore, environmentError = New(os.Getenv("TWODRIVE_RESUME"))
+	})
+	return environmentStore, environmentError
+}
+
+var progressAgent = regexp.MustCompile(`(?:^| )TwoDrive/([a-f0-9]{16})(?: |$)`)
+
+type progressContext struct{}
+
+type ProgressSnapshot struct {
+	Version   int     `json:"version"`
+	Key       string  `json:"key"`
+	Run       string  `json:"run"`
+	ID        string  `json:"id"`
+	Name      string  `json:"name"`
+	Direction string  `json:"direction"`
+	Phase     string  `json:"phase"`
+	Size      int64   `json:"size"`
+	Bytes     int64   `json:"bytes"`
+	Saved     int64   `json:"saved_bytes"`
+	Resumed   bool    `json:"resumed"`
+	Confirmed bool    `json:"confirmed"`
+	Speed     float64 `json:"speed"`
+	Note      string  `json:"note"`
+	Updated   int64   `json:"updated"`
+	Complete  bool    `json:"complete"`
+}
+
+type Progress struct {
+	mu        sync.Mutex
+	store     *Store
+	state     ProgressSnapshot
+	lastBytes int64
+	lastTime  time.Time
+}
+
+func NewProgress(s *Store, ua, key, name, direction string, size int64) *Progress {
+	match := progressAgent.FindStringSubmatch(ua)
+	if s == nil || len(match) != 2 {
+		return nil
+	}
+	id := make([]byte, 16)
+	if _, err := rand.Read(id); err != nil {
+		return nil
+	}
+	p := &Progress{store: s, state: ProgressSnapshot{Version: 1, Key: key, Run: match[1], ID: hex.EncodeToString(id),
+		Name: name, Direction: direction, Size: size, Phase: "verifying", Note: "正在读取并校验文件和上次保存的分片"}}
+	var old ProgressSnapshot
+	if s.Read("h-"+key+".json", &old) == nil && old.Version == 1 && old.Key == key && old.Size == size && old.Direction == direction {
+		p.state.Saved = min(size, max(0, old.Bytes))
+	}
+	p.publish(false)
+	return p
+}
+
+func WithProgress(ctx context.Context, p *Progress) context.Context {
+	return context.WithValue(ctx, progressContext{}, p)
+}
+func ProgressFrom(ctx context.Context) *Progress {
+	p, _ := ctx.Value(progressContext{}).(*Progress)
+	return p
+}
+
+func (p *Progress) publish(checkpoint bool) {
+	p.state.Updated = time.Now().Unix()
+	_ = p.store.Write("p-"+p.state.Run+".json", p.state)
+	if checkpoint {
+		_ = p.store.Write("h-"+p.state.Key+".json", p.state)
+	}
+}
+
+// Saved is only a visual hint until this run has verified the recorded blocks.
+func (p *Progress) Saved(n int64) {
+	if p == nil {
+		return
+	}
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	p.state.Saved = min(p.state.Size, max(0, n))
+	p.publish(false)
+}
+
+func (p *Progress) Begin(verified int64) {
+	if p == nil {
+		return
+	}
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	p.state.Bytes = min(p.state.Size, max(0, verified))
+	p.state.Confirmed = true
+	p.state.Resumed = verified > 0
+	p.state.Phase = "transferring"
+	p.state.Note = ""
+	if verified > 0 {
+		p.state.Phase = "resuming"
+		p.state.Note = fmt.Sprintf("已核对并复用 %d 字节；百分比包含这些已完成分片", verified)
+	}
+	if verified == 0 && p.state.Saved > 0 {
+		p.state.Note = "文件内容或续传记录发生变化，已核对并重新开始"
+	}
+	p.state.Speed = 0
+	p.lastBytes = p.state.Bytes
+	p.lastTime = time.Now()
+	p.publish(true)
+}
+
+func (p *Progress) Checkpoint(done int64) {
+	if p == nil {
+		return
+	}
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	done = min(p.state.Size, max(0, done))
+	if done <= p.state.Bytes {
+		return
+	} // Parallel ranges must not count a block twice.
+	elapsed := time.Since(p.lastTime).Seconds()
+	if elapsed > 0 {
+		p.state.Speed = float64(done-p.lastBytes) / elapsed
+	}
+	p.state.Bytes = done
+	p.lastBytes = done
+	p.lastTime = time.Now()
+	p.publish(true)
+}
+
+func (p *Progress) Checking(note string) {
+	if p == nil {
+		return
+	}
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	p.state.Phase = "verifying"
+	p.state.Note = note
+	p.state.Speed = 0
+	p.publish(false)
+}
+
+func (p *Progress) Finish(success bool) {
+	if p == nil {
+		return
+	}
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	p.state.Phase = "error"
+	p.state.Speed = 0
+	if success {
+		p.state.Phase = "complete"
+		p.state.Complete = true
+		p.state.Bytes = p.state.Size
+		_ = p.store.Remove("h-" + p.state.Key + ".json")
+	}
+	p.publish(false)
+}
