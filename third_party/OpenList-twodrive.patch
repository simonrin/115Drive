+package op
+
+// TwoDrive's short-lived overwrite journal is deliberately separate from
+// recovery archives. Immutable intent is fsynced BEFORE changing the old file.
+// Recovery derives the outcome from fresh IDs, sizes and SHA1s, never age/name
+// alone. Unknown states stop the sync without deleting either version.
+import (
+	"context"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"os"
+	"path"
+	"path/filepath"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/OpenListTeam/OpenList/v4/internal/conf"
+	"github.com/OpenListTeam/OpenList/v4/internal/driver"
+	"github.com/OpenListTeam/OpenList/v4/internal/errs"
+	"github.com/OpenListTeam/OpenList/v4/internal/model"
+	"github.com/OpenListTeam/OpenList/v4/internal/stream"
+	resume "github.com/OpenListTeam/OpenList/v4/internal/twodrive_resume"
+	"github.com/OpenListTeam/OpenList/v4/pkg/utils"
+)
+
+var twoDriveMu sync.Mutex
+
+type twoDriveContextKey struct{}
+type twoDriveIntent struct {
+	Version   int    `json:"version"`
+	ID        string `json:"id"`
+	Identity  string `json:"identity"`
+	Parent    string `json:"parent"`
+	ParentID  string `json:"parent_id"`
+	Name      string `json:"name"`
+	Temporary string `json:"temporary"`
+	OldID     string `json:"old_id"`
+	OldSHA1   string `json:"old_sha1"`
+	OldSize   int64  `json:"old_size"`
+	NewSHA1   string `json:"new_sha1"`
+	NewSize   int64  `json:"new_size"`
+}
+
+func twoDriveEnabled(s driver.Driver) bool {
+	return os.Getenv("TWODRIVE_TRANSACTIONS") != "" && s.Config().Name == "115 Cloud" &&
+		s.GetStorage().MountPath == "/115" && s.GetStorage().Remark == "Managed by TwoDrive"
+}
+func twoDriveScope(p string) bool {
+	return path.Clean(p) == p && (p == "/115Drive" || strings.HasPrefix(p, "/115Drive/")) &&
+		!strings.Contains(p, "\\")
+}
+func twoDriveIdentity(s driver.Driver) (string, error) {
+	var addition struct {
+		Cookie string `json:"cookie"`
+		Root   string `json:"root_folder_id"`
+	}
+	if json.Unmarshal([]byte(s.GetStorage().Addition), &addition) != nil {
+		return "", fmt.Errorf("TwoDrive: invalid storage identity")
+	}
+	uid := ""
+	for _, entry := range strings.Split(addition.Cookie, ";") {
+		k, v, ok := strings.Cut(strings.TrimSpace(entry), "=")
+		if ok && k == "UID" {
+			uid = strings.Split(v, "_")[0]
+		}
+	}
+	if uid == "" || addition.Root != "0" {
+		return "", fmt.Errorf("TwoDrive: account identity unavailable")
+	}
+	digest := sha256.Sum256([]byte(fmt.Sprintf("%d|%s|%s", s.GetStorage().ID, addition.Root, uid)))
+	return hex.EncodeToString(digest[:]), nil
+}
+func twoDriveHex(s string, n int) bool {
+	b, err := hex.DecodeString(s)
+	return err == nil && len(b) == n
+}
+func twoDriveValid(j twoDriveIntent) bool {
+	return j.Version == 1 && twoDriveHex(j.ID, 16) && twoDriveHex(j.Identity, 32) &&
+		twoDriveScope(j.Parent) && j.ParentID != "" && j.OldID != "" &&
+		j.Name != "." && j.Name != ".." && j.Name != "" && path.Base(j.Name) == j.Name &&
+		!strings.ContainsAny(j.Name, "\\\x00") &&
+		j.Temporary == "twodrive_pending_"+j.ID+path.Ext(j.Name) &&
+		j.OldSize >= 0 && j.NewSize >= 0 && twoDriveHex(j.OldSHA1, 20) && twoDriveHex(j.NewSHA1, 20)
+}
+func twoDriveWrite(j twoDriveIntent) (string, error) {
+	dir := os.Getenv("TWODRIVE_TRANSACTIONS")
+	if err := os.MkdirAll(dir, 0700); err != nil {
+		return "", err
+	}
+	filename := filepath.Join(dir, j.ID+".json")
+	data, err := json.Marshal(j)
+	if err != nil {
+		return "", err
+	}
+	f, err := os.OpenFile(filename, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0600)
+	if err != nil {
+		return "", err
+	}
+	_, err = f.Write(data)
+	if err == nil {
+		err = f.Sync()
+	}
+	closeErr := f.Close()
+	if err == nil {
+		err = closeErr
+	}
+	return filename, err
+}
+func twoDriveMatches(o model.Obj, id, hash string, size int64) bool {
+	return o != nil && !o.IsDir() && (id == "" || o.GetID() == id) &&
+		o.GetSize() == size && strings.EqualFold(o.GetHash().GetHash(utils.SHA1), hash)
+}
+func twoDriveObjects(ctx context.Context, s driver.Driver, parent model.Obj) (map[string]model.Obj, error) {
+	rows, err := s.List(ctx, parent, model.ListArgs{Refresh: true, SkipHook: true})
+	if err != nil {
+		return nil, err
+	}
+	result := make(map[string]model.Obj)
+	seen := make(map[string]bool)
+	for _, o := range rows {
+		k := strings.ToLower(o.GetName())
+		if seen[k] {
+			return nil, fmt.Errorf("TwoDrive: ambiguous cloud names; recovery stopped")
+		}
+		seen[k] = true
+		result[o.GetName()] = o
+	}
+	return result, nil
+}
+func twoDriveReconcile(ctx context.Context, s driver.Driver, j twoDriveIntent, filename string) error {
+	identity, err := twoDriveIdentity(s)
+	if err != nil {
+		return err
+	}
+	if !twoDriveValid(j) || identity != j.Identity || filepath.Base(filename) != j.ID+".json" {
+		return fmt.Errorf("TwoDrive: invalid or different-account transaction; recovery stopped")
+	}
+	// Resolve the current path freshly and require the original parent ID.
+	// Invalidate only the path's ancestor listings, retaining unrelated startup
+	// caches. Object IDs below prove the resolved folder has not been replaced.
+	for p := path.Dir(j.Parent); ; p = path.Dir(p) {
+		Cache.dirCache.Delete(Key(s, p))
+		if p == "/" {
+			break
+		}
+	}
+	parent, err := GetUnwrap(ctx, s, j.Parent)
+	if err != nil {
+		return err
+	}
+	if parent.GetID() != j.ParentID {
+		return fmt.Errorf("TwoDrive: transaction folder moved or replaced")
+	}
+	objects, err := twoDriveObjects(ctx, s, parent)
+	if err != nil {
+		return err
+	}
+	final, temp := objects[j.Name], objects[j.Temporary]
+	oldFinal := twoDriveMatches(final, j.OldID, j.OldSHA1, j.OldSize)
+	oldTemp := twoDriveMatches(temp, j.OldID, j.OldSHA1, j.OldSize)
+	newFinal := twoDriveMatches(final, "", j.NewSHA1, j.NewSize)
+	switch {
+	case temp == nil && (oldFinal || newFinal):
+		// No rename yet, rollback already finished, or commit already cleaned.
+	case oldTemp && final == nil:
+		renamer, ok := s.(driver.RenameResult)
+		if !ok {
+			return errs.NotImplement
+		}
+		if _, err = renamer.Rename(ctx, temp, j.Name); err != nil {
+			return err
+		}
+		objects, err = twoDriveObjects(ctx, s, parent)
+		if err != nil {
+			return err
+		}
+		if objects[j.Temporary] != nil || !twoDriveMatches(objects[j.Name], j.OldID, j.OldSHA1, j.OldSize) {
+			return fmt.Errorf("TwoDrive: rollback verification failed")
+		}
+	case oldTemp && newFinal:
+		remover, ok := s.(driver.Remove)
+		if !ok {
+			return errs.NotImplement
+		}
+		// Delete only the exact recorded old object, never an arbitrary name.
+		if err = remover.Remove(ctx, temp); err != nil {
+			return err
+		}
+		objects, err = twoDriveObjects(ctx, s, parent)
+		if err != nil {
+			return err
+		}
+		if objects[j.Temporary] != nil || !twoDriveMatches(objects[j.Name], final.GetID(), j.NewSHA1, j.NewSize) {
+			return fmt.Errorf("TwoDrive: commit verification failed")
+		}
+	default:
+		return fmt.Errorf("TwoDrive: interrupted upload conflicts with cloud changes; files retained")
+	}
+	Cache.deleteDirectoryTree(Key(s, j.Parent))
+	return os.Remove(filename)
+}
+func twoDriveRecoverLocked(ctx context.Context, s driver.Driver) error {
+	entries, err := os.ReadDir(os.Getenv("TWODRIVE_TRANSACTIONS"))
+	if os.IsNotExist(err) {
+		return nil
+	}
+	if err != nil {
+		return err
+	}
+	for _, e := range entries {
+		if !strings.HasSuffix(e.Name(), ".json") {
+			continue
+		}
+		info, err := e.Info()
+		if err != nil {
+			return err
+		}
+		if !info.Mode().IsRegular() || info.Size() > 65536 {
+			return fmt.Errorf("TwoDrive: invalid transaction record")
+		}
+		filename := filepath.Join(os.Getenv("TWODRIVE_TRANSACTIONS"), e.Name())
+		data, err := os.ReadFile(filename)
+		if err != nil {
+			return err
+		}
+		var j twoDriveIntent
+		if json.Unmarshal(data, &j) != nil {
+			return fmt.Errorf("TwoDrive: unreadable transaction; recovery stopped")
+		}
+		if err = twoDriveReconcile(ctx, s, j, filename); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+func twoDriveRecover(ctx context.Context, s driver.Driver) error {
+	if !twoDriveEnabled(s) || ctx.Value(twoDriveContextKey{}) != nil {
+		return nil
+	}
+	twoDriveMu.Lock()
+	defer twoDriveMu.Unlock()
+	return twoDriveRecoverLocked(context.WithValue(ctx, twoDriveContextKey{}, true), s)
+}
+
+type twoDriveHashedStream struct {
+	model.FileStreamer
+	hash utils.HashInfo
+}
+
+func (s *twoDriveHashedStream) GetHash() utils.HashInfo { return s.hash }
+
+func twoDrivePut(ctx context.Context, s driver.Driver, dir string, file model.FileStreamer, up driver.UpdateProgress) (result error) {
+	// Start before receiving/hashing the new content, including overwrite
+	// transactions. A prior percentage is explicitly unverified until the
+	// driver has checked the source identity and server's part acknowledgements.
+	if file.GetSize() > 10*utils.MB && os.Getenv("TWODRIVE_RESUME") != "" {
+		if identity, err := twoDriveIdentity(s); err == nil {
+			if store, err := resume.EnvironmentStore(); err == nil {
+				ua, _ := ctx.Value(conf.UserAgentKey).(string)
+				p := resume.NewProgress(store, ua, resume.Key(identity, dir, file.GetName(), fmt.Sprint(file.GetSize())),
+					path.Join(dir, file.GetName()), "upload", file.GetSize())
+				if p != nil {
+					ctx = resume.WithProgress(ctx, p)
+					defer func() { p.Finish(result == nil) }()
+				}
+			}
+		}
+	}
+	twoDriveMu.Lock()
+	defer twoDriveMu.Unlock()
+	ctx = context.WithValue(ctx, twoDriveContextKey{}, true)
+	if err := twoDriveRecoverLocked(ctx, s); err != nil {
+		return err
+	}
+	if err := MakeDir(ctx, s, dir); err != nil && !errs.IsObjectAlreadyExists(err) {
+		return err
+	}
+	parent, err := GetUnwrap(ctx, s, dir)
+	if err != nil {
+		return err
+	}
+	if model.ObjHasMask(parent, model.NoWrite) {
+		return errs.PermissionDenied
+	}
+	objects, err := twoDriveObjects(ctx, s, parent)
+	if err != nil {
+		return err
+	}
+	old := objects[file.GetName()]
+	if old != nil && old.IsDir() {
+		return errs.NotFile
+	}
+	putter, ok := s.(driver.PutResult)
+	if !ok {
+		return errs.NotImplement
+	}
+	if up == nil {
+		up = func(float64) {}
+	}
+	defer Cache.deleteDirectoryTree(Key(s, dir))
+	if old == nil {
+		_, err = putter.Put(ctx, parent, file, up)
+		return err
+	}
+	// Finish receiving the upload before moving the old cloud file. Reuse this
+	// SHA1 in the driver's existing cache/upload handshake (no second hash pass).
+	_, hash, err := stream.CacheFullAndHash(file, &up, utils.SHA1)
+	if err != nil {
+		return err
+	}
+	if twoDriveMatches(old, "", hash, file.GetSize()) {
+		return nil
+	}
+	identity, err := twoDriveIdentity(s)
+	if err != nil {
+		return err
+	}
+	id := make([]byte, 16)
+	if _, err = rand.Read(id); err != nil {
+		return err
+	}
+	j := twoDriveIntent{Version: 1, ID: hex.EncodeToString(id), Identity: identity,
+		Parent: dir, ParentID: parent.GetID(), Name: file.GetName(), OldID: old.GetID(),
+		OldSHA1: old.GetHash().GetHash(utils.SHA1), OldSize: old.GetSize(), NewSHA1: hash, NewSize: file.GetSize()}
+	j.Temporary = "twodrive_pending_" + j.ID + path.Ext(j.Name)
+	if !twoDriveValid(j) || objects[j.Temporary] != nil {
+		return fmt.Errorf("TwoDrive: cannot safely journal overwrite")
+	}
+	filename, err := twoDriveWrite(j)
+	if err != nil {
+		return err
+	}
+	defer func() {
+		cleanup, cancel := context.WithTimeout(context.WithoutCancel(ctx), 2*time.Minute)
+		defer cancel()
+		if err := twoDriveReconcile(cleanup, s, j, filename); err != nil {
+			result = fmt.Errorf("TwoDrive: pending transaction retained for recovery: %w", err)
+		}
+	}()
+	renamer, ok := s.(driver.RenameResult)
+	if !ok {
+		return errs.NotImplement
+	}
+	if _, err = renamer.Rename(ctx, old, j.Temporary); err != nil {
+		return err
+	}
+	// Re-read after rename, before allowing an upload that could create duplicates.
+	objects, err = twoDriveObjects(ctx, s, parent)
+	if err != nil {
+		return err
+	}
+	if objects[j.Name] != nil || !twoDriveMatches(objects[j.Temporary], j.OldID, j.OldSHA1, j.OldSize) {
+		return fmt.Errorf("TwoDrive: rename verification failed")
+	}
+	wrapped := &twoDriveHashedStream{FileStreamer: file, hash: utils.NewHashInfo(utils.SHA1, hash)}
+	_, err = putter.Put(ctx, parent, wrapped, up)
+	return err
+}
