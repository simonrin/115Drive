+++ b/OpenList-4.2.6/internal/twodrive_resume/progress_test.go
@@ -0,0 +1,78 @@
+package twodrive_resume
+
+import (
+	"context"
+	"testing"
+)
+
+func TestTwoDriveProgressRestartKeepsSavedThenVerifiedBytes(t *testing.T) {
+	dir := t.TempDir()
+	s, err := New(dir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	key := Key("file")
+	ua := "Mozilla/5.0 TwoDrive/0123456789abcdef"
+	p := NewProgress(s, ua, key, "文件.bin", "upload", 64<<20)
+	p.Begin(0)
+	p.Checkpoint(16 << 20)
+	p.Finish(false)
+	s.Close()
+	s, err = New(dir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer s.Close()
+	p = NewProgress(s, ua, key, "文件.bin", "upload", 64<<20)
+	read := func() ProgressSnapshot {
+		var r ProgressSnapshot
+		if err := s.Read("p-0123456789abcdef.json", &r); err != nil {
+			t.Fatal(err)
+		}
+		return r
+	}
+	r := read()
+	if r.Phase != "verifying" || r.Saved != 16<<20 || r.Confirmed {
+		t.Fatal(r)
+	}
+	p.Begin(16 << 20)
+	r = read()
+	if r.Phase != "resuming" || r.Bytes != 16<<20 || !r.Confirmed {
+		t.Fatal(r)
+	}
+	p.Checkpoint(24 << 20)
+	p.Checkpoint(16 << 20)
+	r = read()
+	if r.Bytes != 24<<20 {
+		t.Fatal("parallel progress regressed", r)
+	}
+	p.Checkpoint(64 << 20)
+	p.Checking("确认文件")
+	r = read()
+	if r.Phase != "verifying" || r.Bytes != 64<<20 || r.Speed != 0 {
+		t.Fatal(r)
+	}
+	p.Finish(true)
+	var old ProgressSnapshot
+	if s.Read("h-"+key+".json", &old) == nil {
+		t.Fatal("completed hint retained")
+	}
+}
+
+func TestTwoDriveProgressChangedContentAndWriteFailure(t *testing.T) {
+	s, _ := New(t.TempDir())
+	p := NewProgress(s, "TwoDrive/0123456789abcdef", Key("file"), "file", "upload", 64<<20)
+	p.Saved(32 << 20)
+	p.Begin(0)
+	var r ProgressSnapshot
+	s.Read("p-0123456789abcdef.json", &r)
+	if r.Bytes != 0 || r.Resumed || r.Note == "" {
+		t.Fatal(r)
+	}
+	s.Close()
+	// Reporting is best effort; a locked/missing progress file never fails data.
+	p.Checkpoint(8 << 20)
+	p.Checking("test")
+	p.Finish(false)
+	ProgressFrom(context.Background()).Begin(0)
+}
--- a/OpenList-4.2.6/internal/twodrive_resume/store.go
+++ b/OpenList-4.2.6/internal/twodrive_resume/store.go
@@ -0,0 +1,215 @@
+// Package twodrive_resume holds transfer checkpoints, never file versions.
+package twodrive_resume
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"io"
+	"os"
+	"regexp"
+	"sync"
+	"time"
+)
+
+const BlockSize int64 = 8 << 20
+
+var validName = regexp.MustCompile(`^(?:[duh]-[a-f0-9]{64}(?:\.json|(?:\.[0-9]{6}\.bin))|p-[a-f0-9]{16}\.json)(?:\.tmp)?$`)
+
+// A lease prevents cleanup from racing any active transfer. os.Root confines
+// all reads and removals, including malicious/replaced symlinks, to this cache.
+type Store struct {
+	root      *os.Root
+	life      sync.RWMutex
+	meta      [256]sync.Mutex
+	block     [256]sync.Mutex
+	lastClean time.Time
+}
+
+func Key(parts ...string) string {
+	data, _ := json.Marshal(parts) // Length-delimited: names cannot alias fields.
+	sum := sha256.Sum256(data)
+	return hex.EncodeToString(sum[:])
+}
+
+func New(directory string) (*Store, error) {
+	if err := os.MkdirAll(directory, 0700); err != nil {
+		return nil, err
+	}
+	root, err := os.OpenRoot(directory)
+	if err != nil {
+		return nil, err
+	}
+	s := &Store{root: root}
+	owner := []byte("TwoDrive transfer checkpoints v1\n")
+	got, err := root.ReadFile("owner.txt")
+	if os.IsNotExist(err) {
+		var entries []os.DirEntry
+		f, e := root.Open(".")
+		if e == nil {
+			entries, e = f.ReadDir(-1)
+			f.Close()
+		}
+		if e != nil || len(entries) != 0 {
+			root.Close()
+			return nil, fmt.Errorf("resume cache is not empty/unowned")
+		}
+		err = s.write("owner.txt", owner)
+	} else if err == nil && string(got) != string(owner) {
+		err = fmt.Errorf("resume cache ownership mismatch")
+	}
+	if err != nil {
+		root.Close()
+		return nil, err
+	}
+	s.Clean(time.Now())
+	return s, nil
+}
+
+func (s *Store) Close() error { return s.root.Close() }
+
+func (s *Store) Lease() func() {
+	s.Clean(time.Now())
+	s.life.RLock()
+	return s.life.RUnlock
+}
+
+func (s *Store) Lock(key string) func() {
+	n := sha256.Sum256([]byte(key))
+	s.meta[n[0]].Lock()
+	return s.meta[n[0]].Unlock
+}
+
+func (s *Store) Read(name string, value any) error {
+	if !validName.MatchString(name) {
+		return fmt.Errorf("invalid checkpoint name")
+	}
+	info, err := s.root.Lstat(name)
+	if err != nil {
+		return err
+	}
+	if !info.Mode().IsRegular() || info.Size() > 8<<20 {
+		return fmt.Errorf("invalid checkpoint file")
+	}
+	b, err := s.root.ReadFile(name)
+	if err != nil {
+		return err
+	}
+	return json.Unmarshal(b, value)
+}
+
+func (s *Store) write(name string, b []byte) error {
+	tmp := name + ".tmp"
+	// Remove the directory entry first: do not follow an existing link.
+	if err := s.root.Remove(tmp); err != nil && !os.IsNotExist(err) {
+		return err
+	}
+	f, err := s.root.OpenFile(tmp, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0600)
+	if err != nil {
+		return err
+	}
+	_, err = f.Write(b)
+	if err == nil {
+		err = f.Sync()
+	}
+	closeErr := f.Close()
+	if err == nil {
+		err = closeErr
+	}
+	if err == nil {
+		err = s.root.Rename(tmp, name)
+	}
+	return err
+}
+
+func (s *Store) Write(name string, value any) error {
+	if !validName.MatchString(name) {
+		return fmt.Errorf("invalid checkpoint name")
+	}
+	b, err := json.Marshal(value)
+	if err != nil {
+		return err
+	}
+	return s.write(name, b)
+}
+
+func (s *Store) Remove(name string) error {
+	if !validName.MatchString(name) {
+		return fmt.Errorf("invalid checkpoint name")
+	}
+	err := s.root.Remove(name)
+	if os.IsNotExist(err) {
+		return nil
+	}
+	return err
+}
+
+// Clean only recognized records and their exact block names. Unknown/corrupt
+// records are retained. Finished downloads live one day for interrupted local
+// delivery; unfinished transfers expire after seven days without use.
+func (s *Store) Clean(now time.Time) {
+	if !s.life.TryLock() {
+		return
+	}
+	defer s.life.Unlock()
+	if now.Sub(s.lastClean) < time.Hour {
+		return
+	}
+	s.lastClean = now
+	f, err := s.root.Open(".")
+	if err != nil {
+		return
+	}
+	entries, err := f.ReadDir(-1)
+	f.Close()
+	if err != nil {
+		return
+	}
+	for _, entry := range entries {
+		name := entry.Name()
+		if len(name) == 23 && validName.MatchString(name) {
+			var record ProgressSnapshot
+			if s.Read(name, &record) == nil && record.Version == 1 && record.Run == name[2:18] && record.Updated > 0 && now.Sub(time.Unix(record.Updated, 0)) > 24*time.Hour {
+				_ = s.root.Remove(name)
+				_ = s.root.Remove(name + ".tmp")
+			}
+			continue
+		}
+		if !validName.MatchString(name) || len(name) != 71 {
+			continue
+		} // [du]-hash.json
+		var header struct {
+			Version  int    `json:"version"`
+			Key      string `json:"key"`
+			Updated  int64  `json:"updated"`
+			Complete bool   `json:"complete"`
+		}
+		if s.Read(name, &header) != nil || header.Version != 1 || name[2:66] != header.Key || header.Updated <= 0 {
+			continue
+		}
+		ttl := 7 * 24 * time.Hour
+		if header.Complete {
+			ttl = 24 * time.Hour
+		}
+		if now.Sub(time.Unix(header.Updated, 0)) < ttl {
+			continue
+		}
+		prefix := name[:66]
+		for _, candidate := range entries {
+			n := candidate.Name()
+			if validName.MatchString(n) && len(n) >= 66 && n[:66] == prefix {
+				info, e := s.root.Lstat(n)
+				if e == nil && info.Mode().IsRegular() {
+					_ = s.root.Remove(n)
+				}
+			}
+		}
+	}
+}
+
+func readExact(r io.Reader, n int64) ([]byte, error) {
+	b := make([]byte, n)
+	_, err := io.ReadFull(r, b)
+	return b, err
+}
