+func TestTwoDriveUploadRestartsReuseAcknowledgedAndAmbiguousParts(t *testing.T) {
+	for _, ambiguous := range []bool{false, true} {
+		t.Run(map[bool]string{false: "before-part", true: "lost-ack"}[ambiguous], func(t *testing.T) {
+			dir := t.TempDir()
+			s, _ := resume.New(dir)
+			data := bytes.Repeat([]byte("abcdefghijklmnop"), 2<<20) // 32 MiB / four parts.
+			h := sha1.Sum(data)
+			hash := hex.EncodeToString(h[:])
+			key := resume.Key("account", "directory", "name", hash)
+			backend := &fakeMultipart{failPart: 3, loseACK: ambiguous}
+			init := func() (*driver115.UploadOSSParams, *UploadResult, error) {
+				return &driver115.UploadOSSParams{Bucket: "bucket", Object: "object"}, nil, nil
+			}
+			_, err := runMultipart(context.Background(), s, key, hash, int64(len(data)), bytes.NewReader(data), backend, init, func(float64) {})
+			if err == nil {
+				t.Fatal("expected interruption")
+			}
+			already := backend.sent
+			s.Close()
+			s, err = resume.New(dir)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer s.Close()
+			backend.failPart = 0
+			backend.sent = 0
+			_, err = runMultipart(context.Background(), s, key, hash, int64(len(data)), bytes.NewReader(data), backend, init, func(float64) {})
+			if err != nil {
+				t.Fatal(err)
+			}
+			if backend.sent != int64(len(data))-already || backend.initCount != 1 {
+				t.Fatal("reuploaded parts", backend.sent, already, backend.initCount)
+			}
+		})
+	}
+}
+
+func TestTwoDriveUploadRefusesChangedPartsAndTransientFailure(t *testing.T) {
+	for _, mode := range []string{"changed", "offline", "expired"} {
+		t.Run(mode, func(t *testing.T) {
+			s, _ := resume.New(t.TempDir())
+			defer s.Close()
+			data := make([]byte, 16<<20)
+			h := sha1.Sum(data)
+			hash := hex.EncodeToString(h[:])
+			key := resume.Key(hash)
+			b := &fakeMultipart{failPart: 2}
+			init := func() (*driver115.UploadOSSParams, *UploadResult, error) {
+				return &driver115.UploadOSSParams{Bucket: "bucket", Object: "object"}, nil, nil
+			}
+			runMultipart(context.Background(), s, key, hash, int64(len(data)), bytes.NewReader(data), b, init, func(float64) {})
+			b.failPart = 0
+			b.sent = 0
+			switch mode {
+			case "changed":
+				b.parts[0].ETag = "wrong"
+			case "offline":
+				b.listError = errors.New("network unavailable")
+			case "expired":
+				b.listError = oss.ServiceError{Code: "NoSuchUpload"}
+			}
+			_, err := runMultipart(context.Background(), s, key, hash, int64(len(data)), bytes.NewReader(data), b, init, func(float64) {})
+			if mode == "expired" {
+				if err != nil || b.initCount != 2 || b.sent != int64(len(data)) {
+					t.Fatal("expiry fallback failed", err)
+				}
+			} else if err == nil || b.sent != 0 || b.initCount != 1 {
+				t.Fatal("unsafe restart", err, b.sent)
+			}
+		})
+	}
