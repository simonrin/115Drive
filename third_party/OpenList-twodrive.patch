+++ b/OpenList-4.2.6/internal/twodrive_resume/download_test.go
@@ -0,0 +1,143 @@
+package twodrive_resume
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/OpenListTeam/OpenList/v4/pkg/http_range"
+)
+
+func TestTwoDriveDownloadRestartAndCorruptChunk(t *testing.T) {
+	dir := t.TempDir()
+	data := make([]byte, 3*BlockSize+123)
+	for i := range data {
+		data[i] = byte(i % 251)
+	}
+	var network atomic.Int64
+	fetch := func(ctx context.Context, offset, size int64) (io.ReadCloser, error) {
+		network.Add(size)
+		return io.NopCloser(bytes.NewReader(data[offset : offset+size])), nil
+	}
+	s, err := New(dir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	key := Key("account", "file", "sha1", "size")
+	d := Download{Store: s, Key: key, Size: int64(len(data)), Fetch: fetch}
+	first, _ := d.RangeRead(context.Background(), http_range.Range{Length: 2 * BlockSize})
+	if _, err = io.Copy(io.Discard, first); err != nil {
+		t.Fatal(err)
+	}
+	first.Close()
+	s.Close()
+	if network.Load() != 2*BlockSize {
+		t.Fatal(network.Load())
+	}
+	// Restart, with one valid and one corrupt saved block.
+	if err = os.WriteFile(filepath.Join(dir, fmt.Sprintf("d-%s.%06d.bin", key, 1)), []byte("corrupt"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	s, err = New(dir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer s.Close()
+	d.Store = s
+	network.Store(0)
+	restarted, _ := d.RangeRead(context.Background(), http_range.Range{Length: -1})
+	got, err := io.ReadAll(restarted)
+	restarted.Close()
+	if err != nil || sha256.Sum256(got) != sha256.Sum256(data) {
+		t.Fatal("wrong restarted content", err)
+	}
+	if network.Load() != int64(len(data))-BlockSize {
+		t.Fatalf("did not reuse verified chunk: %d", network.Load())
+	}
+	var rec downloadRecord
+	if err = s.Read("d-"+key+".json", &rec); err != nil || !rec.Complete || rec.ReusedBytes != BlockSize {
+		t.Fatal(rec, err)
+	}
+}
+
+func TestTwoDriveParallelRangesAndShortRead(t *testing.T) {
+	s, _ := New(t.TempDir())
+	defer s.Close()
+	var network atomic.Int64
+	d := Download{Store: s, Key: Key("parallel"), Size: 2 * BlockSize, Fetch: func(ctx context.Context, start, n int64) (io.ReadCloser, error) {
+		network.Add(n)
+		return io.NopCloser(bytes.NewReader(make([]byte, n))), nil
+	}}
+	var wg sync.WaitGroup
+	for i := 0; i < 4; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			r, e := d.RangeRead(context.Background(), http_range.Range{Start: BlockSize / 2, Length: BlockSize})
+			if e != nil {
+				t.Error(e)
+				return
+			}
+			_, e = io.Copy(io.Discard, r)
+			r.Close()
+			if e != nil {
+				t.Error(e)
+			}
+		}()
+	}
+	wg.Wait()
+	if network.Load() != 2*BlockSize {
+		t.Fatal("duplicate network chunks", network.Load())
+	}
+	d.Key = Key("short")
+	d.Fetch = func(context.Context, int64, int64) (io.ReadCloser, error) {
+		return io.NopCloser(bytes.NewReader([]byte{1})), nil
+	}
+	r, _ := d.RangeRead(context.Background(), http_range.Range{Length: -1})
+	_, err := io.Copy(io.Discard, r)
+	r.Close()
+	if err == nil {
+		t.Fatal("accepted short network block")
+	}
+	var rec downloadRecord
+	s.Read("d-"+d.Key+".json", &rec)
+	if len(rec.Blocks) != 0 {
+		t.Fatal("short block checkpointed")
+	}
+}
+
+func TestTwoDriveCleanupLeasesAndUnknownFiles(t *testing.T) {
+	dir := t.TempDir()
+	s, _ := New(dir)
+	defer s.Close()
+	key := Key("old")
+	rec := downloadRecord{Version: 1, Key: key, Updated: time.Now().Add(-8 * 24 * time.Hour).Unix(), Size: BlockSize, Blocks: map[int]string{}}
+	s.Write("d-"+key+".json", rec)
+	os.WriteFile(filepath.Join(dir, "d-"+key+".000000.bin"), []byte("old"), 0600)
+	os.WriteFile(filepath.Join(dir, "keep.txt"), []byte("user"), 0600)
+	unknown := "d-" + Key("corrupt") + ".json"
+	os.WriteFile(filepath.Join(dir, unknown), []byte("{"), 0600)
+	release := s.Lease()
+	s.Clean(time.Now().Add(2 * time.Hour))
+	if _, err := os.Stat(filepath.Join(dir, "d-"+key+".json")); err != nil {
+		t.Fatal("active data removed")
+	}
+	release()
+	s.Clean(time.Now().Add(2 * time.Hour))
+	if _, err := os.Stat(filepath.Join(dir, "d-"+key+".json")); !os.IsNotExist(err) {
+		t.Fatal("expired data not removed")
+	}
+	for _, name := range []string{"keep.txt", unknown} {
+		if _, err := os.Stat(filepath.Join(dir, name)); err != nil {
+			t.Fatal(err)
+		}
+	}
+}
