+++ b/OpenList-4.2.6/internal/twodrive_resume/download.go
@@ -0,0 +1,239 @@
+package twodrive_resume
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"fmt"
+	"io"
+	"os"
+	"sync"
+	"time"
+
+	"github.com/OpenListTeam/OpenList/v4/pkg/http_range"
+)
+
+type Fetch func(context.Context, int64, int64) (io.ReadCloser, error)
+
+type Download struct {
+	Store        *Store
+	Key          string
+	Size         int64
+	Fetch        Fetch
+	Progress     *Progress
+	prepareOnce  sync.Once
+	prepareError error
+}
+
+type downloadRecord struct {
+	Version      int            `json:"version"`
+	Key          string         `json:"key"`
+	Size         int64          `json:"size"`
+	Updated      int64          `json:"updated"`
+	Complete     bool           `json:"complete"`
+	Blocks       map[int]string `json:"blocks"`
+	NetworkBytes int64          `json:"network_bytes"`
+	ReusedBytes  int64          `json:"reused_bytes"`
+}
+
+func (d *Download) record() (downloadRecord, error) {
+	r := downloadRecord{Version: 1, Key: d.Key, Size: d.Size, Blocks: map[int]string{}}
+	err := d.Store.Read("d-"+d.Key+".json", &r)
+	if os.IsNotExist(err) {
+		err = nil
+	}
+	if err == nil && (r.Version != 1 || r.Key != d.Key || r.Size != d.Size || r.Blocks == nil) {
+		err = fmt.Errorf("download checkpoint identity mismatch")
+	}
+	return r, err
+}
+
+func (d *Download) blockBytes(blocks map[int]string) int64 {
+	var total int64
+	for index := range blocks {
+		if index >= 0 && int64(index)*BlockSize < d.Size {
+			total += min(BlockSize, d.Size-int64(index)*BlockSize)
+		}
+	}
+	return total
+}
+
+// Check saved chunks before reporting them as confirmed progress. This runs
+// once for the shared link, including when rclone requests parallel ranges.
+func (d *Download) prepare(ctx context.Context) error {
+	unlock := d.Store.Lock(d.Key)
+	defer unlock()
+	rec, err := d.record()
+	if err != nil {
+		return err
+	}
+	d.Progress.Saved(d.blockBytes(rec.Blocks))
+	for index, expected := range rec.Blocks {
+		if err = ctx.Err(); err != nil {
+			return err
+		}
+		valid := false
+		if index >= 0 && int64(index)*BlockSize < d.Size && len(expected) == 64 {
+			name := fmt.Sprintf("d-%s.%06d.bin", d.Key, index)
+			info, e := d.Store.root.Lstat(name)
+			if e == nil && info.Mode().IsRegular() && info.Size() == min(BlockSize, d.Size-int64(index)*BlockSize) {
+				b, e := d.Store.root.ReadFile(name)
+				sum := sha256.Sum256(b)
+				valid = e == nil && hex.EncodeToString(sum[:]) == expected
+			}
+		}
+		if !valid {
+			delete(rec.Blocks, index)
+		}
+	}
+	rec.Updated = time.Now().Unix()
+	rec.Complete = d.blockBytes(rec.Blocks) == d.Size
+	if err = d.Store.Write("d-"+d.Key+".json", rec); err != nil {
+		return err
+	}
+	d.Progress.Begin(d.blockBytes(rec.Blocks))
+	if rec.Complete {
+		d.Progress.Checking("缓存已校验，正在确认本地文件")
+	}
+	return nil
+}
+
+func (d *Download) chunk(ctx context.Context, index int) ([]byte, error) {
+	s := d.Store
+	chunkName := fmt.Sprintf("d-%s.%06d.bin", d.Key, index)
+	guard := sha256.Sum256([]byte(chunkName))
+	s.block[guard[0]].Lock()
+	defer s.block[guard[0]].Unlock()
+	size := min(BlockSize, d.Size-int64(index)*BlockSize)
+	unlock := s.Lock(d.Key)
+	rec, err := d.record()
+	hash := rec.Blocks[index]
+	unlock()
+	if err != nil {
+		return nil, err
+	}
+	reused := false
+	var b []byte
+	if len(hash) == 64 {
+		info, e := s.root.Lstat(chunkName)
+		if e == nil && info.Mode().IsRegular() && info.Size() == size {
+			b, e = s.root.ReadFile(chunkName)
+			sum := sha256.Sum256(b)
+			reused = e == nil && hex.EncodeToString(sum[:]) == hash
+		}
+	}
+	if !reused {
+		if err := ctx.Err(); err != nil {
+			return nil, err
+		}
+		rc, e := d.Fetch(ctx, int64(index)*BlockSize, size)
+		if e != nil {
+			return nil, e
+		}
+		b, err = readExact(rc, size)
+		rc.Close()
+		if err != nil {
+			return nil, err
+		} // Never mark truncated chunks complete.
+		sum := sha256.Sum256(b)
+		hash = hex.EncodeToString(sum[:])
+		if err = s.write(chunkName, b); err != nil {
+			return nil, err
+		}
+	}
+	unlock = s.Lock(d.Key)
+	defer unlock()
+	rec, err = d.record()
+	if err != nil {
+		return nil, err
+	}
+	rec.Blocks[index] = hash
+	rec.Updated = time.Now().Unix()
+	rec.Complete = int64(len(rec.Blocks)) == (d.Size+BlockSize-1)/BlockSize
+	if reused {
+		rec.ReusedBytes += size
+	} else {
+		rec.NetworkBytes += size
+	}
+	if err = s.Write("d-"+d.Key+".json", rec); err != nil {
+		return nil, err
+	}
+	d.Progress.Checkpoint(d.blockBytes(rec.Blocks))
+	if rec.Complete {
+		d.Progress.Checking("数据已传完，正在确认本地文件")
+	}
+	return b, nil
+}
+
+func (d *Download) RangeRead(ctx context.Context, r http_range.Range) (io.ReadCloser, error) {
+	if r.Start < 0 || r.Start > d.Size {
+		return nil, fmt.Errorf("invalid resume range")
+	}
+	length := r.Length
+	if length < 0 || length > d.Size-r.Start {
+		length = d.Size - r.Start
+	}
+	release := d.Store.Lease()
+	d.prepareOnce.Do(func() { d.prepareError = d.prepare(ctx) })
+	if d.prepareError != nil {
+		release()
+		return nil, d.prepareError
+	}
+	unlock := d.Store.Lock(d.Key)
+	rec, err := d.record()
+	if err == nil {
+		rec.Updated = time.Now().Unix()
+		err = d.Store.Write("d-"+d.Key+".json", rec)
+	}
+	unlock()
+	if err != nil {
+		release()
+		return nil, err
+	}
+	return &downloadReader{download: d, ctx: ctx, pos: r.Start, end: r.Start + length, index: -1, release: release}, nil
+}
+
+type downloadReader struct {
+	download *Download
+	ctx      context.Context
+	pos, end int64
+	index    int
+	block    []byte
+	release  func()
+}
+
+func (r *downloadReader) Read(p []byte) (int, error) {
+	if r.release == nil {
+		return 0, os.ErrClosed
+	}
+	if err := r.ctx.Err(); err != nil {
+		return 0, err
+	}
+	if len(p) == 0 {
+		return 0, nil
+	}
+	if r.pos >= r.end {
+		return 0, io.EOF
+	}
+	index := int(r.pos / BlockSize)
+	if index != r.index {
+		b, err := r.download.chunk(r.ctx, index)
+		if err != nil {
+			return 0, err
+		}
+		r.block, r.index = b, index
+	}
+	offset := r.pos % BlockSize
+	n := copy(p, r.block[offset:min(int64(len(r.block)), offset+r.end-r.pos)])
+	r.pos += int64(n)
+	return n, nil
+}
+
+func (r *downloadReader) Close() error {
+	if r.release != nil {
+		r.release()
+		r.release = nil
+		r.block = nil
+	}
+	return nil
+}
